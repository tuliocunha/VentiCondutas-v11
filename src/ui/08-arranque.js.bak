/* ============================================================
   VENTCONDUTAS V10.0.0 · 08-arranque
   ============================================================ */
(function () {
'use strict';
const VC = window.VC;
window.VC6 = window.VC6 || {};
const VC6 = window.VC6;
VC._boot.partes.push('08-arranque');

VC.ui = VC.ui || {};
if (typeof VC.ui.renderSidebar !== 'function') {
  VC.ui.renderSidebar = function () {
    const sidebar = document.getElementById('sidebar');
    if (!sidebar) return;
    sidebar.innerHTML = '<div class="grupo-sidebar" data-fase="contexto"><div class="grupo-titulo">1 · Contexto</div><button class="passo-btn ativo" data-passo="setup" onclick="VC.ui.setPasso(\'setup\')"><div class="passo-icone"><i class="fa-solid fa-gear"></i></div><div class="passo-corpo"><div class="passo-nome">Setup do Projeto</div><div class="passo-sub">Tipologia · QAI · premissas ISA</div></div><div class="passo-estado ok"></div></button></div>';
  };
}

VC.grafoEstado = {
  condutas: { rot: { x: -0.30, y: 0.40 }, zoom: 0.55, offset: { x: 0, y: 0 }, arrastando: false, modoDrag: 'rotate', lastX: 0, lastY: 0, selecionado: null, filtro: 'tudo', canais: { volume: true, cor: true, borda: true, satur: true, arcos: true }, animacao: false },
  conceitual: { rot: { x: -0.30, y: 0.40 }, zoom: 0.55, offset: { x: 0, y: 0 }, arrastando: false, modoDrag: 'rotate', lastX: 0, lastY: 0, selecionado: null, filtro: 'tudo', canais: { volume: true, cor: true, borda: true, satur: true, arcos: true }, animacao: false }
};

const CAM = { dist: 3500, fov: 2000 };
VC.projetar = function (estado, x, y, z) {
  const x1 = x * Math.cos(estado.rot.y) - z * Math.sin(estado.rot.y);
  const z1 = x * Math.sin(estado.rot.y) + z * Math.cos(estado.rot.y);
  const y2 = y * Math.cos(estado.rot.x) - z1 * Math.sin(estado.rot.x);
  const z2 = y * Math.sin(estado.rot.x) + z1 * Math.cos(estado.rot.x);
  const fator = (CAM.fov / (CAM.dist + z2)) * estado.zoom;
  return { x: x1 * fator + estado.offset.x, y: y2 * fator + estado.offset.y, scale: fator, z: z2 };
};

VC.modeloGrafo = {
  construirCondutas() {
    const nos = []; const X = { UTA: -1400, RAMAL: -900, SUB: -500, TERMINAL: -100, ESPACO: 600 };
    const Y_REDE = { insuflacao: -350, extracao: 350, extracao_suja: 350 }; const Z = { P0: -300, P1: 0, P2: 300 };
    const pisoDe = (str) => { const s = (str || '').toLowerCase(); if (/p0|piso 0/.test(s)) return 'P0'; if (/p1|piso 1/.test(s)) return 'P1'; return 'P0'; };
    VC.dados.utas.forEach(u => { nos.push({ id: 'NO-UTA-' + u.id, tipo: 'uta', nome: u.nome, pos: [X.UTA, Y_REDE[u.rede] || 0, Z.P0], rede: u.rede, _dados: u }); });
    VC.dados.ramais.forEach(r => { const isPrincipal = (r.nivelNumero || 1) === 1; nos.push({ id: 'NO-RAM-' + r.id, tipo: isPrincipal ? 'ramal' : 'sub', nome: r.nome, pos: [isPrincipal ? X.RAMAL : X.SUB, Y_REDE[r.rede] || 0, Z[pisoDe(r.nome)]], rede: r.rede, _dados: r }); });
    VC.dados.terminais.forEach(t => { nos.push({ id: 'NO-TERM-' + t.id, tipo: 'terminal', nome: t.nome, pos: [X.TERMINAL, Y_REDE[t.rede] || 0, Z[pisoDe(t.nome)]], rede: t.rede, _dados: t }); });
    nos.forEach(n => {
      if (n.tipo === 'uta') { n.Q = n._dados.Q * 3600 || 0; n.dp = (n._dados.dpExt + n._dados.dpInt) || 0; n.v = 0; n.zeta = 0; n.status = n._dados.status || 'OK'; }
      else if (n.tipo === 'ramal' || n.tipo === 'sub') { n.Q = n._dados.Q || 0; n.dp = n._dados.deltaPtotal || 0; n.v = n._dados.v || 0; n.zeta = n._dados.zeta || 0; n.status = n._dados.status || 'OK'; }
      else if (n.tipo === 'terminal') { const v = VC.calculo.verificarTerminal(n._dados); n.Q = n._dados.Q || 0; n.dp = v.dPCalc || 0; n.v = n._dados.v_saida || 0; n.zeta = 0; n.status = v.status; }
    });
    return nos;
  },
  construirArestasCondutas() {
    const arestas = []; const byName = {}; VC.dados.ramais.forEach(r => { byName[r.nome] = r; });
    VC.dados.ramais.forEach(r => { if (r.parente && byName[r.parente]) return; let uta = null; if (r.utaRef) uta = VC.dados.utas.find(u => u.id === r.utaRef); if (!uta) uta = VC.dados.utas.find(u => u.rede === (r.rede || 'insuflacao')); if (uta) arestas.push({ de: 'NO-UTA-' + uta.id, para: 'NO-RAM-' + r.id }); });
    VC.dados.ramais.forEach(r => { if (r.parente && byName[r.parente]) arestas.push({ de: 'NO-RAM-' + byName[r.parente].id, para: 'NO-RAM-' + r.id }); });
    VC.dados.terminais.forEach(t => { if (t.ramalRef && byName[t.ramalRef]) arestas.push({ de: 'NO-RAM-' + byName[t.ramalRef].id, para: 'NO-TERM-' + t.id }); });
    return arestas;
  }
};

VC.grafoCondutas = {
  nos: [], arestas: [],
  render() {
    const svg = document.getElementById('grafoSVG-condutas'); if (!svg) return;
    const gRaiz = document.getElementById('gRaiz-condutas'); const gA = document.getElementById('gArestas-condutas'); const gE = document.getElementById('gEsferas-condutas');
    if (!gRaiz || !gA || !gE) return;
    this.nos = VC.modeloGrafo.construirCondutas(); this.arestas = VC.modeloGrafo.construirArestasCondutas();
    const estado = VC.grafoEstado.condutas; const rect = svg.getBoundingClientRect(); const W = rect.width || 900, H = rect.height || 500;
    gRaiz.setAttribute('transform', 'translate(' + W / 2 + ',' + H / 2 + ')'); while (gA.firstChild) gA.removeChild(gA.firstChild); while (gE.firstChild) gE.removeChild(gE.firstChild);
    const proj = {}; this.nos.forEach(n => { proj[n.id] = VC.projetar(estado, n.pos[0], n.pos[1], n.pos[2]); });
    const Qmax = Math.max.apply(null, [1].concat(this.nos.map(n => n.Q || 0)));
    const arestasOrd = this.arestas.slice().sort((a, b) => { const za = ((proj[a.de] || {}).z + (proj[a.para] || {}).z) / 2 || 0; const zb = ((proj[b.de] || {}).z + (proj[b.para] || {}).z) / 2 || 0; return zb - za; });
    arestasOrd.forEach(a => {
      const pA = proj[a.de], pB = proj[a.para]; if (!pA || !pB) return;
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', 'M' + pA.x.toFixed(1) + ',' + pA.y.toFixed(1) + ' L' + pB.x.toFixed(1) + ',' + pB.y.toFixed(1));
      path.setAttribute('fill', 'none'); path.setAttribute('stroke', '#8aa9c5'); path.setAttribute('stroke-width', 1.5); path.setAttribute('stroke-opacity', 0.6); gA.appendChild(path);
    });
    const nosOrd = this.nos.slice().sort((a, b) => ((proj[a.id] || {}).z || 0) - ((proj[b.id] || {}).z || 0));
    nosOrd.forEach(n => {
      const p = proj[n.id]; if (!p) return; const r = VC.escalas.raioPorQ(n.Q || 0, Qmax, 10, 30) * p.scale;
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g'); g.setAttribute('transform', 'translate(' + p.x.toFixed(1) + ',' + p.y.toFixed(1) + ')'); g.setAttribute('data-id', n.id);
      const estadoCor = n.status === 'OK' ? 'ok' : (n.status === 'ATENÇÃO' ? 'atencao' : (n.status === 'PENDENTE' ? 'pendente' : 'erro'));
      const circ = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      circ.setAttribute('r', r); circ.setAttribute('fill', VC.cores.porEstado(estadoCor)); circ.setAttribute('stroke', estado.selecionado === n.id ? '#2c3e50' : '#4f6d8c'); circ.setAttribute('stroke-width', estado.selecionado === n.id ? 2.5 : 1.5); circ.setAttribute('opacity', 0.92); g.appendChild(circ);
      if (estado.canais.arcos && n.status && n.status !== 'OK') { const arco = document.createElementNS('http://www.w3.org/2000/svg', 'path'); const q = estadoCor === 'ok' ? 'ok' : (estadoCor === 'atencao' ? 'atencao' : (estadoCor === 'erro' ? 'erro' : 'pendente')); arco.setAttribute('d', VC.arcos.path(q, r + 3, r + 1)); arco.setAttribute('fill', VC.arcos.cores[q]); g.appendChild(arco); }
      g.addEventListener('click', () => { estado.selecionado = n.id; VC.grafoCondutas.render(); VC.grafoCondutas.renderPainel(n); }); gE.appendChild(g);
    });
    const stVis = document.getElementById('statVisiveisCond'); const stTot = document.getElementById('statTotalCond'); const stZoom = document.getElementById('statZoomCond'); const stFil = document.getElementById('statFiltroCond');
    if (stVis) stVis.textContent = this.nos.length; if (stTot) stTot.textContent = this.nos.length; if (stZoom) stZoom.textContent = Math.round(estado.zoom * 100) + '%'; if (stFil) stFil.textContent = estado.filtro;
  },
  renderPainel(n) {
    const cont = document.getElementById('painelGrafoCondutas'); if (!cont || !n) return;
    let h = '<div class="inputs-grupo"><div class="inputs-grupo-cab"><i class="fa-solid fa-cube"></i> ' + VC.utils.esc(n.nome) + '</div><div class="inputs-grupo-corpo">';
    h += '<div style="font-size:11px;color:var(--texto-med);margin-bottom:8px">Tipo: <b>' + VC.utils.esc(n.tipo) + '</b> · Rede: <b>' + VC.utils.esc(n.rede || '—') + '</b></div><div class="output-grid">';
    h += '<div class="output-card"><div class="output-label">Q</div><div class="output-valor">' + VC.utils.fmt(n.Q, 0) + '<span class="output-unidade">m³/h</span></div></div>';
    h += '<div class="output-card"><div class="output-label">Δp</div><div class="output-valor">' + VC.utils.fmt(n.dp, 0) + '<span class="output-unidade">Pa</span></div></div>';
    h += '<div class="output-card"><div class="output-label">v</div><div class="output-valor">' + VC.utils.fmt(n.v, 2) + '<span class="output-unidade">m/s</span></div></div>';
    h += '<div class="output-card"><div class="output-label">Estado</div><div class="output-valor">' + VC.utils.esc(n.status || '—') + '</div></div></div></div></div>';
    cont.innerHTML = h;
  }
};

VC.grafoConceitual = {
  nos: [], arestas: [],
  render() {
    const svg = document.getElementById('grafoSVG-conceitual'); if (!svg) return;
    const gA = document.getElementById('gArestas-conceitual'); const gE = document.getElementById('gEsferas-conceitual'); const gRaiz = document.getElementById('gRaiz-conceitual');
    if (!gA || !gE || !gRaiz) return; while (gA.firstChild) gA.removeChild(gA.firstChild); while (gE.firstChild) gE.removeChild(gE.firstChild);
    const estado = VC.grafoEstado.conceitual; const rect = svg.getBoundingClientRect(); const W = rect.width || 900, H = rect.height || 500;
    gRaiz.setAttribute('transform', 'translate(' + W / 2 + ',' + H / 2 + ')');
    const nos = [ { id: 'ctx', tipo: 'dados', nome: 'Contexto', pos: [-1000, -300, -200] }, { id: 'esp', tipo: 'dados', nome: 'Espaços', pos: [-1000, -100, 0] }, { id: 'term', tipo: 'dados', nome: 'Terminais', pos: [-500, 0, 100] }, { id: 'ram', tipo: 'dados', nome: 'Ramais', pos: [0, 0, 200] }, { id: 'uta', tipo: 'dados', nome: 'Ventilador', pos: [500, 0, 100] }, { id: 'bal', tipo: 'dados', nome: 'Balanço', pos: [0, 250, 200] }, { id: 'out', tipo: 'output', nome: 'Relatórios', pos: [1000, 0, 0] } ];
    const arestas = [ { de: 'ctx', para: 'esp' },{ de: 'esp', para: 'term' },{ de: 'term', para: 'ram' },{ de: 'ram', para: 'uta' },{ de: 'bal', para: 'esp' },{ de: 'uta', para: 'out' } ];
    const proj = {}; nos.forEach(n => { proj[n.id] = VC.projetar(estado, n.pos[0], n.pos[1], n.pos[2]); });
    arestas.forEach(a => { const pA = proj[a.de], pB = proj[a.para]; if (!pA || !pB) return; const path = document.createElementNS('http://www.w3.org/2000/svg', 'path'); path.setAttribute('d', 'M' + pA.x.toFixed(1) + ',' + pA.y.toFixed(1) + ' L' + pB.x.toFixed(1) + ',' + pB.y.toFixed(1)); path.setAttribute('fill', 'none'); path.setAttribute('stroke', '#8aa9c5'); path.setAttribute('stroke-width', 2); gA.appendChild(path); });
    nos.forEach(n => {
      const p = proj[n.id]; if (!p) return; const g = document.createElementNS('http://www.w3.org/2000/svg', 'g'); g.setAttribute('transform', 'translate(' + p.x.toFixed(1) + ',' + p.y.toFixed(1) + ')'); g.setAttribute('data-id', n.id);
      const circ = document.createElementNS('http://www.w3.org/2000/svg', 'circle'); circ.setAttribute('r', 22 * p.scale); circ.setAttribute('fill', n.tipo === 'output' ? '#eef5f0' : '#e8f0f8'); circ.setAttribute('stroke', '#6d8fb0'); circ.setAttribute('stroke-width', 1.6); g.appendChild(circ);
      const t = document.createElementNS('http://www.w3.org/2000/svg', 'text'); t.setAttribute('text-anchor', 'middle'); t.setAttribute('y', (26 * p.scale) + 'px'); t.setAttribute('font-size', '10px'); t.textContent = n.nome; g.appendChild(t); gE.appendChild(g);
    });
  }
};

VC.interacaoGrafo = {
  ligar(grafoNome, svgId) {
    const svg = document.getElementById(svgId); if (!svg || svg._ligadoV5) return; svg._ligadoV5 = true;
    const estado = VC.grafoEstado[grafoNome]; const renderFn = grafoNome === 'condutas' ? VC.grafoCondutas : VC.grafoConceitual;
    svg.addEventListener('mousedown', ev => { if (ev.target.closest('g[data-id]')) return; estado.arrastando = true; estado.lastX = ev.clientX; estado.lastY = ev.clientY; });
    window.addEventListener('mousemove', ev => { if (!estado.arrastando) return; const dx = ev.clientX - estado.lastX, dy = ev.clientY - estado.lastY; estado.lastX = ev.clientX; estado.lastY = ev.clientY; estado.rot.y += dx * 0.006; estado.rot.x += dy * 0.006; estado.rot.x = Math.max(-1.4, Math.min(1.4, estado.rot.x)); VC.perf.throttleRAF(() => renderFn.render())(); });
    window.addEventListener('mouseup', () => { estado.arrastando = false; });
    svg.addEventListener('wheel', ev => { ev.preventDefault(); estado.zoom *= (ev.deltaY > 0 ? 0.92 : 1.08); estado.zoom = Math.max(0.15, Math.min(4, estado.zoom)); VC.perf.throttleRAF(() => renderFn.render())(); }, { passive: false });
  }
};

VC.pesquisaGlobal = { buscar(q) { const btn = document.getElementById('pesquisaGlobalLimpar'); if (btn) btn.style.display = q ? 'block' : 'none'; VC._pesquisaGlobal = q; }, limpar() { const inp = document.getElementById('pesquisaGlobal'); const btn = document.getElementById('pesquisaGlobalLimpar'); if (inp) inp.value = ''; if (btn) btn.style.display = 'none'; VC._pesquisaGlobal = ''; } };
VC.pesquisaGrafo = { buscar() {} }; VC.tour = { iniciar() {}, proximo() {}, parar() {} }; VC.animacao = { toggle() {} }; VC.vistas = { padrao() {}, fluxo() {} }; VC.exportacao = { png() {} };
VC.controlos = { toggle() {}, setZoom() {}, reset() {}, setArestaEspessura() {}, setArestaCor() {}, toggleAnimacao() {}, toggleMatrizDispersao() {}, setVista() {}, preset() {} };

VC.layoutV2 = {
  JANELAS: [
    { id: 'parametros',     num: 1, nome: '1 · Parâmetros',     passos: ['setup', 'configuracoes'] },
    { id: 'ambientes',      num: 2, nome: '2 · Ambientes',       passos: ['levantamento', 'classificacao'] },
    { id: 'especificacoes', num: 3, nome: '3 · Especificações',  passos: ['requisitos', 'terminais', 'associacao', 'rede', 'utas'] },
    { id: 'topologia',      num: 4, nome: '4 · Topologia',       passos: ['balanco', 'transferencias', 'diagrama-rede'] },
    { id: 'verificacao',    num: 5, nome: '5 · Verificação',     passos: ['otimizacao', 'normativa', 'diagnostico'] },
    { id: 'entrega',        num: 6, nome: '6 · Entrega',         passos: ['relatorios', 'caderno'] }
  ],
  janelaAtiva: null,
  passoParaJanela: function (passoId) { for (var i = 0; i < this.JANELAS.length; i++) { if (this.JANELAS[i].passos.indexOf(passoId) >= 0) return this.JANELAS[i].id; } return null; },
  passosDaJanela: function (janelaId) { for (var i = 0; i < this.JANELAS.length; i++) { if (this.JANELAS[i].id === janelaId) return this.JANELAS[i].passos.slice(); } return []; },
  _aplicarFiltroSidebar: function () {
    if (!this.janelaAtiva) return; var passosPermitidos = new Set(this.passosDaJanela(this.janelaAtiva)); var gruposPermitidos = new Set();
    (VC.passosCatalogo || []).forEach(function (p) { if (passosPermitidos.has(p.id)) gruposPermitidos.add(p.grupo); });
    document.querySelectorAll('.grupo-sidebar[data-fase]').forEach(function (el) { var fase = el.getAttribute('data-fase'); el.style.display = gruposPermitidos.has(fase) ? '' : 'none'; });
    document.querySelectorAll('.passo-btn[data-passo]').forEach(function (el) { var passoId = el.getAttribute('data-passo'); el.style.display = passosPermitidos.has(passoId) ? '' : 'none'; });
    var subsPorSubgrupo = {};
    (VC.passosCatalogo || []).forEach(function (p) { if (p.subgrupo) { if (!subsPorSubgrupo[p.subgrupo]) subsPorSubgrupo[p.subgrupo] = []; subsPorSubgrupo[p.subgrupo].push(p.id); } });
    document.querySelectorAll('.subgrupo-sidebar[data-sub]').forEach(function (el) { var sub = el.getAttribute('data-sub'); var passosDoSub = subsPorSubgrupo[sub] || []; var temPermitido = passosDoSub.some(function (pid) { return passosPermitidos.has(pid); }); el.style.display = temPermitido ? '' : 'none'; });
  },
  _limparFiltroSidebar: function () {
    document.querySelectorAll('.grupo-sidebar[data-fase]').forEach(function (el) { el.style.display = ''; });
    document.querySelectorAll('.passo-btn[data-passo]').forEach(function (el) { el.style.display = ''; });
    document.querySelectorAll('.subgrupo-sidebar[data-sub]').forEach(function (el) { el.style.display = ''; });
  },
  setJanelaAtiva: function (num) { var janela = this.JANELAS.filter(function (j) { return j.num === Number(num); })[0]; if (!janela) return; this.janelaAtiva = janela.id; this._aplicarFiltroSidebar(); },
  renderLens: function (nome) {
    if (!VC.flags.layoutV2) return; var el = document.getElementById('conteudoPasso'); if (!el) return;
    if (nome === 'visual') nome = 'passo';
    if (nome === 'passo') { if (VC.passos && typeof VC.passos.render === 'function') { VC.passos.render(VC._passoAtivo || 'setup'); } }
    else if (nome === 'hasse') { if (VC.lentes && typeof VC.lentes.renderVisualHasse === 'function') { el.innerHTML = VC.lentes.renderVisualHasse(); } else { el.innerHTML = '<div class="vazio">Módulo de lentes não carregado.</div>'; } }
    else if (nome === 'tabela') { if (VC.lentes && typeof VC.lentes.renderTabelaEspacos === 'function') { el.innerHTML = VC.lentes.renderTabelaEspacos(); } else { el.innerHTML = '<div class="vazio">Módulo de lentes não carregado.</div>'; } }
    else if (nome === 'kanban') { if (VC.lentes && typeof VC.lentes.renderKanbanEspacos === 'function') { el.innerHTML = VC.lentes.renderKanbanEspacos(); } else { el.innerHTML = '<div class="vazio">Módulo de lentes não carregado.</div>'; } }
  }
};

VC.configuracoes = {
  abrir() {
    const modal = document.getElementById('modalConfiguracoes'); const cont = document.getElementById('modalConfigConteudo'); if (!modal || !cont) return;
    const cats = [ { nome: '1 · Topologia e rede', itens: [['topologiaReal', 'Topologia real'], ['zetaDinamico', 'ζ dinâmico de Tês'], ['sincronizacao', 'Sincronização automática'], ['mapaTrechos', 'Mapa de trechos'], ['equilibrioTrechos', 'Equilíbrio de trechos']] }, { nome: '2 · UTAs e ventilador', itens: [['utasPorRede', 'UTAs por rede'], ['pontoFuncionamentoAuto', 'Ponto de funcionamento automático'], ['curvasFabricantes', 'Curvas reais de fabricantes']] }, { nome: '3 · Conformidade', itens: [['estanquidade', 'Estanquidade'], ['cortaFogo', 'Corta-Fogo'], ['filtrosCarga', 'Filtros com carga'], ['ruidoUta', 'Ruído de UTA'], ['velocidadeMax', 'Velocidade máxima']] }, { nome: '4 · Balanço de ar (V8.0.1)', itens: [['balancoAr', 'Balanço de ar por espaço'], ['transferencias', 'Transferências entre espaços'], ['validacaoCiclos', 'Deteção de ciclos'], ['pressaoRelativa', 'Cálculo de pressão relativa']] }, { nome: '5 · F-RPH · Conforto térmico', itens: [['confortoTermico', 'Caudal de conforto (RPH × V) por espaço']] }, { nome: '6 · QAI_projeto (V8.0.1)', itens: [['qaiProjeto', 'QAI definido pelo engenheiro (por grupo · com motivo auditável)']] }, { nome: '7 · Interface', itens: [['modoNormalEng', 'Modo Normal / Engenharia'], ['editorDetalhado', 'Editor detalhado'], ['tooltips', 'Tooltips contextuais'], ['painel2x3', 'Painel inferior 2×3']] }, { nome: '8 · Relatórios e PDF', itens: [['graficosModernos', 'Gráficos modernos'], ['pdf10pag', 'PDF profissional 10-15 páginas'], ['cadernoParametrizado', 'Caderno de encargos parametrizado'], ['usoDadosPainel', 'Bloco "Como os dados são usados"'], ['legendaUnificada', 'Legenda unificada'], ['arHumidoPainel', 'Painel ar húmido']] }, { nome: '9 · Diagrama de Rede (N9)', itens: [['diagramaN9', 'Diagrama N9 ativo'], ['diagramaInterativo', 'Interatividade (zoom/pan)'], ['diagramaFiltros', 'Filtros por rede/nível'], ['diagramaExportSVG', 'Exportar SVG'], ['diagramaExportPNG', 'Exportar PNG'], ['diagramaIntegrarPDF', 'Integrar no PDF']] }, { nome: '10 · Extras', itens: [['diagramaSVG', 'Diagrama SVG'], ['importacaoCSV', 'Importação CSV'], ['modoComparacao', 'Modo comparação'], ['modoArvore', 'Modo Árvore visual']] }, { nome: '11 · Gestão de exemplos', itens: [['gestaoExemplos', 'Gestão de exemplos (localStorage + JSON)']] } ];
    let h = '<div class="modal-cabecalho"><h3><i class="fa-solid fa-sliders"></i> Configurações ' + VC.versao + '</h3><button class="fechar" onclick="VC.ui.fecharModal(\'modalConfiguracoes\')">×</button></div><div class="modal-corpo">';
    h += '<div style="padding:10px 12px;background:var(--primario-soft);border-radius:6px;font-size:11px;color:var(--primario-esc);margin-bottom:14px"><b>VentCondutas V9.2:</b> F-RPH + QAI_projeto + <b>Topologia facetada</b> + <b>Árvore interativa</b> + <b>Layout V2 · 6 Janelas</b> + <b>Lente Hasse</b>.</div>';
    cats.forEach(cat => {
      h += '<div style="margin-bottom:16px"><div style="font-size:10.5px;font-weight:800;text-transform:uppercase;color:var(--texto-med);margin-bottom:6px;padding-bottom:4px;border-bottom:1px solid var(--borda)">' + cat.nome + '</div>';
      cat.itens.forEach(([k, label]) => { const on = VC.flags[k] === true; h += '<div style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:7px 10px;background:var(--superf2);border-radius:5px;margin-bottom:3px"><span style="font-size:11.5px">' + label + '</span><label style="display:inline-flex;align-items:center;cursor:pointer;gap:8px"><input type="checkbox" ' + (on ? 'checked' : '') + ' onchange="VC.configuracoes.toggle(\'' + k + '\', this.checked)" style="width:16px;height:16px;accent-color:var(--primario)"></label></div>'; });
      h += '</div>';
    });
    h += '<div style="margin-top:20px;padding:12px;background:var(--superf3);border-radius:8px"><div style="font-size:11px;font-weight:800;margin-bottom:8px;color:var(--texto-med)">Manutenção</div><div style="display:flex;gap:6px;flex-wrap:wrap"><button class="btn btn-mini" onclick="VC.configuracoes.limparCaches()"><i class="fa-solid fa-broom"></i> Limpar caches</button><button class="btn btn-mini ambar" onclick="VC.catalogo.reset(); VC.ui.toast(\'Catálogo reposto.\');"><i class="fa-solid fa-rotate"></i> Repor catálogo</button><button class="btn btn-mini violeta" onclick="VC.ui.abrirTestes()"><i class="fa-solid fa-vial"></i> Abrir painel de testes</button></div></div></div><div class="modal-rodape"><button class="btn primario" onclick="VC.ui.fecharModal(\'modalConfiguracoes\')">Fechar</button></div>';
    cont.innerHTML = h; modal.classList.add('on');
  },
  toggle(n, v) {
    VC.flags[n] = !!v;
    if (n === 'confortoTermico') { if (v) VC.rph.aplicarATodos(); VC.estado.sincronizar(); VC.ui.toast('Conforto térmico ' + (v ? 'ON' : 'OFF')); }
    if (n === 'qaiProjeto') { VC.estado.sincronizar(); VC.ui.toast('QAI_projeto ' + (v ? 'ON' : 'OFF')); }
    this.abrir();
  },
  limparCaches() { VC.perf.cacheCalculo.invalidar(); VC.perf.cacheFisica.invalidar(); VC.perf.cacheMaterializacao.invalidar(); VC.perf.ordenacaoTopologica.invalidar(); VC.perf.cacheBalanco.invalidar(); VC.calculo.calcularTudo(); if (VC6.balanco) VC6.balanco.propagar(); VC.ui.toast('Caches limpas.'); }
};

VC.ui = VC.ui || {}; VC._passoAtivo = VC._passoAtivo || 'setup';
VC.ui.estadoPasso = function (passo) {
  try {
    let est = 'vazio', n = 0, resumo = '';
    if (passo === 'setup') {
      est = (VC.dados.metadados && VC.dados.metadados.nome) ? 'ok' : 'pendente';
    } else if (passo === 'levantamento') {
      n = (VC.dados.espacos || []).length;
      est = n > 0 ? 'ok' : 'pendente';
      resumo = n + ' esp.';
    } else if (passo === 'classificacao') {
      const esp = VC.dados.espacos || [];
      if (!esp.length) est = 'pendente';
      else {
        const semQ = esp.filter(e => !e.tipo || !e.Q_normas).length;
        if (semQ > 0) { est = 'atencao'; n = semQ; resumo = n + ' s/ Q'; }
        else est = 'ok';
      }
    } else if (passo === 'requisitos') {
      const cob = VC.requisitos ? VC.requisitos.coberturaGlobal() : null;
      if (!cob || cob.totalEspacos === 0) est = 'pendente';
      else if (cob.semReq > 0) { est = 'atencao'; n = cob.semReq; resumo = n + ' s/ def'; }
      else est = 'ok';
    } else if (passo === 'terminais') {
      n = (VC.dados.terminais || []).length;
      est = n > 0 ? 'ok' : 'pendente';
      resumo = n + ' term.';
    } else if (passo === 'associacao') {
      const ram = VC.dados.ramais || [];
      if (!ram.length) est = 'pendente';
      else {
        const semTerm = ram.filter(r => !VC.dados.terminais.some(t => t.ramalRef === r.nome)).length;
        if (semTerm > 0) { est = 'atencao'; n = semTerm; resumo = n + ' s/ term'; }
        else est = 'ok';
      }
    } else if (passo === 'rede') {
      n = (VC.dados.ramais || []).length;
      est = n > 0 ? 'ok' : 'pendente';
      resumo = n + ' ramais';
    } else if (passo === 'utas') {
      n = (VC.dados.utas || []).length;
      est = n > 0 ? 'ok' : 'pendente';
      resumo = n + ' UTAs';
    } else if (passo === 'normativa') {
      const x = VC.calculo && VC.calculo.ultimo;
      if (!x) est = 'pendente';
      else est = x.overall === 'CONFORME' ? 'ok' : (x.overall === 'ATENÇÃO' ? 'atencao' : 'erro');
    } else if (passo === 'otimizacao') {
      const h = VC.dados.historicoConvergencia || [];
      est = !h.length ? 'pendente' : (h[h.length - 1].convergiu ? 'ok' : 'atencao');
    } else {
      est = 'ok';
    }
    return { estado: est, n: n, resumo: resumo };
  } catch (e) { return { estado: 'vazio', n: 0, resumo: '' }; }
};
VC.ui.setPasso = function (passo) { VC._passoAtivo = passo; if (passo === 'diagrama-rede') VC.modos.set('diagrama-rede'); else if (VC._modoAtivo !== 'condutas') VC.modos.set('condutas'); document.querySelectorAll('.passo-btn').forEach(b => b.classList.toggle('ativo', b.dataset.passo === passo)); if (VC.passos && typeof VC.passos.render === 'function') VC.passos.render(passo); };
VC.ui.toast = function (mensagem, acaoTexto, acaoFn, duracao) { const t = document.getElementById('toast'); const txt = document.getElementById('toastTexto'); const btn = document.getElementById('toastAcao'); if (!t || !txt || !btn) return; t.classList.remove('undo'); txt.textContent = mensagem; if (acaoTexto && typeof acaoFn === 'function') { btn.style.display = 'inline-flex'; btn.textContent = acaoTexto; btn.onclick = function () { acaoFn(); VC.ui.fecharToast(); }; } else { btn.style.display = 'none'; btn.onclick = null; } t.classList.add('on'); clearTimeout(t._timer); t._timer = setTimeout(() => t.classList.remove('on'), duracao || 2800); };
VC.ui.fecharToast = function () { const t = document.getElementById('toast'); if (t) t.classList.remove('on'); };
VC.ui.oferecerUndo = function (mensagem, fnDesfazer) { const t = document.getElementById('toast'); const txt = document.getElementById('toastTexto'); if (!t || !txt) return; t.classList.add('on', 'undo'); txt.innerHTML = '<div class="toast-linha"><span>' + mensagem + '</span><button id="toastUndoBtn"><i class="fa-solid fa-rotate-left"></i> Desfazer (10s)</button></div><div class="toast-barra"><div class="toast-barra-inner anim"></div></div>'; const btn = document.getElementById('toastUndoBtn'); if (btn) btn.onclick = () => { fnDesfazer(); t.classList.remove('on', 'undo'); }; clearTimeout(t._timer); t._timer = setTimeout(() => t.classList.remove('on', 'undo'), 10000); };
VC.ui.abrirModal = function (id) { const m = document.getElementById(id); if (m) m.classList.add('on'); };
VC.ui.fecharModal = function (id) { if (id) { const m = document.getElementById(id); if (m) m.classList.remove('on'); return; } document.querySelectorAll('.modal-overlay.on').forEach(m => m.classList.remove('on')); if (VC.tooltips) VC.tooltips.esconder(); };
VC.ui.guardar = function () { VC.exportacoes.json(); };
VC.ui.guardarComo = function () { const base = (VC.dados.metadados && VC.dados.metadados.nome) ? VC.dados.metadados.nome : 'Projeto'; const nome = 'VentCondutas_v' + VC.versaoCurta + '_' + String(base).replace(/[^A-Za-z0-9_-]+/g, '_') + '_' + new Date().toISOString().slice(0, 10) + '.json'; VC.exportacoes.json(nome); };
VC.ui.validar = function () { const x = VC.calculo.calcularTudo(); VC.ui.toast('Estado: ' + x.overall + ' · ' + (x.findings || []).length + ' findings'); };
VC.ui.novo = function () { if (!confirm('Criar novo projeto? Todos os dados atuais serão perdidos.')) return; VC.dados.espacos = []; VC.dados.ramais = []; VC.dados.terminais = []; VC.dados.nos = []; VC.dados.trechos = []; VC.dados.elementosRede = []; VC.dados.utas = []; VC.dados.transferencias = []; VC.dados.nextId = { espaco: 1, ramal: 1, terminal: 1, componente: 1, uta: 1, no: 1, trecho: 1, elemento: 1, definicao: 1, transferencia: 1 }; VC.dados.metadados = { nome: 'Novo Projeto', cliente: '', local: 'Portugal', autor: '', revisao: '01', descricao: '' }; VC.perf.cacheFisica.invalidar(); VC.perf.cacheMaterializacao.invalidar(); VC.perf.ordenacaoTopologica.invalidar(); VC.perf.cacheBalanco.invalidar(); VC.calculo.calcularTudo(); if (VC6.balanco) VC6.balanco.propagar(); VC.ui.renderSidebar(); VC.passos.render('setup'); VC.ui.toast('Novo projeto criado.'); };
VC.ui.abrir = function () { const inp = document.createElement('input'); inp.type = 'file'; inp.accept = '.json'; inp.onchange = e => { const f = e.target.files[0]; if (!f) return; const r = new FileReader(); r.onload = ev => { try { let p = JSON.parse(ev.target.result); p = VC.migrador.prepararParaImportar(p); VC.dados.metadados = p.metadados || VC.dados.metadados; Object.assign(VC.dados, p.dados); if (p.configuracao) { if (p.configuracao.params) Object.assign(VC.dados.params, p.configuracao.params); if (p.configuracao.tipologia) VC.dados.tipologia = p.configuracao.tipologia; if (p.configuracao.restricaoH) VC.dados.restricaoH = p.configuracao.restricaoH; } VC.dados._versao = 'V9'; VC.perf.cacheFisica.invalidar(); VC.perf.cacheMaterializacao.invalidar(); VC.perf.ordenacaoTopologica.invalidar(); VC.perf.cacheBalanco.invalidar(); VC.calculo.__mig = false; VC.calculo.__migEsp = false; VC.calculo._autoAssoc = false; VC.calculo.calcularTudo(); if (VC6.balanco) VC6.balanco.propagar(); VC.ui.renderSidebar(); VC.passos.render(VC._passoAtivo || 'setup'); VC.ui.toast('Projeto carregado.'); } catch (err) { alert('Erro: ' + err.message); } }; r.readAsText(f); }; inp.click(); };
VC.ui.abrirNormas = function () { const modal = document.getElementById('modalNormas'); const cont = document.getElementById('modalNormasConteudo'); if (!modal || !cont) return; const h = VC.conhecimento.hierarquia; let html = '<div class="modal-cabecalho"><h3><i class="fa-solid fa-scale-balanced"></i> Hierarquia Normativa ' + VC.versao + '</h3><button class="fechar" onclick="VC.ui.fecharModal(\'modalNormas\')">×</button></div><div class="modal-corpo">'; [['nivel1','1 · Legislação PT (obrigatória)'],['nivel2','2 · Normas Europeias'],['nivel3','3 · Normas Internacionais'],['nivel4','4 · Boas Práticas']].forEach(([k, titulo]) => { html += '<h3 style="font-size:12px;margin:12px 0 6px;color:var(--texto-med);text-transform:uppercase;letter-spacing:.4px">' + titulo + '</h3>'; (h[k] || []).forEach(n => { html += '<div style="padding:6px 10px;background:var(--superf2);border-left:3px solid ' + (n.obrigatorio ? 'var(--verde)' : 'var(--texto-suave)') + ';border-radius:5px;margin-bottom:4px;font-size:11px"><b>' + n.codigo + '</b> — ' + n.funcao + '</div>'; }); }); html += '<h3 style="font-size:12px;margin:16px 0 6px;color:var(--texto-med);text-transform:uppercase;letter-spacing:.4px">Princípios de balanço de ar</h3>'; (VC.conhecimento.principiosBalanco || []).forEach(p => { const cor = (p.id === 'P6' || p.id === 'P7' || p.id === 'P8') ? 'var(--primario)' : 'var(--verde)'; const bg = (p.id === 'P6' || p.id === 'P7' || p.id === 'P8') ? 'var(--primario-soft)' : 'var(--verde-soft)'; html += '<div style="padding:6px 10px;background:' + bg + ';border-left:3px solid ' + cor + ';border-radius:5px;margin-bottom:4px;font-size:11px"><b>' + p.id + '</b> — ' + p.texto + ' <span style="color:var(--texto-suave);font-size:10px">(' + p.norma + ')</span></div>'; }); html += '</div>'; cont.innerHTML = html; modal.classList.add('on'); };
VC.ui.abrirCatalogos = function () { const modal = document.getElementById('modalCatalogos'); const cont = document.getElementById('modalCatalogosConteudo'); if (!modal || !cont) return; const contagem = VC.catalogo.contarPorCatalogo(); const curvas = VC.curvasFabricantes.todas(); let h = '<div class="modal-cabecalho"><h3><i class="fa-solid fa-book"></i> Catálogos</h3><button class="fechar" onclick="VC.ui.fecharModal(\'modalCatalogos\')">×</button></div><div class="modal-corpo">'; h += '<h3 style="font-size:12px;margin:0 0 8px;color:var(--texto-med);text-transform:uppercase;letter-spacing:.4px">Terminais</h3>'; contagem.forEach(c => { h += '<div style="border:1px solid var(--borda);border-radius:6px;padding:10px 12px;margin-bottom:6px"><div style="font-weight:800;font-size:12px">' + VC.utils.esc(c.fabricante) + ' · ' + VC.utils.esc(c.tipo) + '</div><div style="font-size:10.5px;color:var(--texto-suave);margin-top:3px">' + c.produtos + ' produtos</div></div>'; }); h += '<h3 style="font-size:12px;margin:16px 0 8px;color:var(--texto-med);text-transform:uppercase;letter-spacing:.4px">Ventiladores (curvas reais · ' + curvas.length + ')</h3>'; curvas.forEach(c => { h += '<div style="border:1px solid var(--borda);border-radius:6px;padding:10px 12px;margin-bottom:6px"><div style="font-weight:800;font-size:12px">' + VC.utils.esc(c.fabricante) + ' · ' + VC.utils.esc(c.serie) + ' · ' + VC.utils.esc(c.modelo) + '</div><div style="font-size:10.5px;color:var(--texto-suave);margin-top:3px">' + c.aplicacao + ' · Q nom ' + VC.utils.fmt(c.Q_nom, 0) + ' m³/h · Δp nom ' + VC.utils.fmt(c.dP_nom, 0) + ' Pa</div></div>'; }); h += '</div>'; cont.innerHTML = h; modal.classList.add('on'); };
VC.ui.abrirConfiguracoes = function () { VC.configuracoes.abrir(); };
VC.ui.congelar = function () { VC.dados.congelado = true; const bf = document.getElementById('btnCongelar'), br = document.getElementById('btnReabrir'); if (bf) bf.style.display = 'none'; if (br) br.style.display = 'inline-flex'; VC.passos.render(VC._passoAtivo); VC.ui.toast('Congelado.'); };
VC.ui.descongelar = function () { VC.dados.congelado = false; const bf = document.getElementById('btnCongelar'), br = document.getElementById('btnReabrir'); if (bf) bf.style.display = 'inline-flex'; if (br) br.style.display = 'none'; VC.passos.render(VC._passoAtivo); VC.ui.toast('Reaberto.'); };
VC.ui.exportar = function () { VC.exportacoes.pdf(); };
VC.ui.atualizarTudo = function () { VC.perf.cacheFisica.invalidar(); VC.perf.cacheMaterializacao.invalidar(); VC.perf.ordenacaoTopologica.invalidar(); VC.perf.cacheBalanco.invalidar(); VC.calculo.calcularTudo(); if (VC6.balanco) VC6.balanco.propagar(); VC.ui.renderSidebar(); if (VC._passoAtivo) VC.passos.render(VC._passoAtivo); VC.ui.toast('Atualizado.'); };
VC.ui.sobre = function () { alert(VC.versao + '\n\n' + 'Layout V2 · 6 Janelas + Topologia facetada + Snap + Lente Hasse\n\n' + '· Módulos: 01-fundamentos · 02-biblioteca · 03-dimensionamento\n' + '· 04-documentacao · 05-amostras · 06-diagramas\n' + '· 07-editores · 08-arranque · 09-topologia · 10-historico-ui · 11-lentes\n\n' + 'Nomenclatura V9: Q_normas · Q_ConTerm · QAI_projeto · Q_total'); };

VC._modoAtivo = VC._modoAtivo || 'condutas';
VC.modos = VC.modos || {};
VC.modos.setJanela = function(num) { if (!VC.flags.layoutV2) return; document.querySelectorAll('.janela-btn').forEach(b => b.classList.toggle('ativo', b.dataset.janela === String(num))); try { localStorage.setItem('VC_layoutV2_janela', String(num)); } catch (e) {} if (VC.layoutV2 && typeof VC.layoutV2.setJanelaAtiva === 'function') { VC.layoutV2.setJanelaAtiva(Number(num)); const janela = VC.layoutV2.JANELAS.filter(function (j) { return j.num === Number(num); })[0]; if (janela && janela.passos.length) { const passoAtivo = VC._passoAtivo || 'setup'; if (janela.passos.indexOf(passoAtivo) < 0 && VC.ui && typeof VC.ui.setPasso === 'function') { VC.ui.setPasso(janela.passos[0]); } } } };
VC.modos.setLente = function(nome) { if (!VC.flags.layoutV2) return; if (nome === 'visual') nome = 'passo'; VC.flags.layoutV2Lente = nome; document.querySelectorAll('.lente-btn').forEach(b => b.classList.toggle('ativo', b.dataset.lente === nome)); try { localStorage.setItem('VC_layoutV2_lente', String(nome)); } catch (e) {} if (VC.layoutV2 && typeof VC.layoutV2.renderLens === 'function') { VC.layoutV2.renderLens(nome); } };
VC.modos.set = function (nome) {
  VC._modoAtivo = nome; document.querySelectorAll('.modo-btn').forEach(b => b.classList.toggle('ativo', b.dataset.modo === nome)); document.querySelectorAll('.modo-painel').forEach(p => p.classList.remove('ativo'));
  const mapa = { 'condutas': 'modo-condutas', 'construtor': 'modo-construtor', 'arvore': 'modo-arvore', 'grafico-condutas': 'modo-grafico-condutas', 'grafico-conceitual': 'modo-grafico-conceitual', 'diagrama-rede': 'modo-diagrama-rede', 'relatorios': 'modo-relatorios' };
  const id = mapa[nome]; if (id) { const el = document.getElementById(id); if (el) el.classList.add('ativo'); }
  setTimeout(() => { try { if (nome === 'arvore') VC.arvore.render(); else if (nome === 'construtor') { if (VC.topologia && VC.topologia.construtor) VC.topologia.construtor.render(); } else if (nome === 'grafico-condutas') { VC.interacaoGrafo.ligar('condutas', 'grafoSVG-condutas'); VC.grafoCondutas.render(); } else if (nome === 'grafico-conceitual') { VC.interacaoGrafo.ligar('conceitual', 'grafoSVG-conceitual'); VC.grafoConceitual.render(); } else if (nome === 'diagrama-rede') { if (VC6.diagrama) VC6.diagrama.render(); } else if (nome === 'relatorios') { if (VC.modoRelatorios && VC.modoRelatorios.render) VC.modoRelatorios.render(); } if (VC.tooltips) VC.tooltips.esconder(); } catch (e) { VC.debug.erro(e); } }, 60);
};

window.renderSetup = function () {
  const p = VC.dados.params;
  let h = '<div class="cartao-titulo"><i class="fa-solid fa-gear"></i> Setup do Projeto</div>';
  h += '<p style="font-size:12px;color:var(--texto-med);margin-bottom:24px">Definir o contexto do projeto. Estes dados alimentam o cálculo ISA/ar húmido em todas as fases.</p>';

  h += '<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: start;">';

  // GRUPO 1: REGISTO
  h += '<div style="background: var(--superf); border: 1px solid var(--borda); border-radius: 12px; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">';
  h += '<div style="display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 700; color: var(--texto); border-bottom: 1px solid var(--borda); padding-bottom: 12px; margin-bottom: 20px;"><i class="fa-solid fa-folder-open" style="color: var(--primario); font-size: 16px;"></i> Registo do Projeto</div>';

  h += '<div style="display: flex; flex-direction: column; gap: 16px;">';

  h += '<div><label style="display:block; font-size:11px; font-weight:700; color:#64748b; margin-bottom:6px; text-transform:uppercase; letter-spacing:0.5px;">Nome do projeto</label><input value="' + VC.utils.esc(VC.dados.metadados.nome) + '" onchange="VC.dados.metadados.nome=this.value; VC.ui.renderSidebar();" style="width:100%; padding:10px 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; color:#1e293b;" onfocus="this.style.borderColor=\'var(--primario)\'; this.style.outline=\'none\';" onblur="this.style.borderColor=\'#cbd5e1\';"></div>';

  h += '<div><label style="display:block; font-size:11px; font-weight:700; color:#64748b; margin-bottom:6px; text-transform:uppercase; letter-spacing:0.5px;">Cliente</label><input value="' + VC.utils.esc(VC.dados.metadados.cliente || '') + '" onchange="VC.dados.metadados.cliente=this.value" style="width:100%; padding:10px 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; color:#1e293b;" onfocus="this.style.borderColor=\'var(--primario)\'; this.style.outline=\'none\';" onblur="this.style.borderColor=\'#cbd5e1\';"></div>';

  h += '<div><label style="display:block; font-size:11px; font-weight:700; color:#64748b; margin-bottom:6px; text-transform:uppercase; letter-spacing:0.5px;">Local</label><input value="' + VC.utils.esc(VC.dados.metadados.local || '') + '" onchange="VC.dados.metadados.local=this.value" style="width:100%; padding:10px 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; color:#1e293b;" onfocus="this.style.borderColor=\'var(--primario)\'; this.style.outline=\'none\';" onblur="this.style.borderColor=\'#cbd5e1\';"></div>';

  h += '<div><label style="display:block; font-size:11px; font-weight:700; color:#64748b; margin-bottom:6px; text-transform:uppercase; letter-spacing:0.5px;">Autor</label><input value="' + VC.utils.esc(VC.dados.metadados.autor || '') + '" onchange="VC.dados.metadados.autor=this.value" style="width:100%; padding:10px 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; color:#1e293b;" onfocus="this.style.borderColor=\'var(--primario)\'; this.style.outline=\'none\';" onblur="this.style.borderColor=\'#cbd5e1\';"></div>';

  h += '<div><label style="display:block; font-size:11px; font-weight:700; color:#64748b; margin-bottom:6px; text-transform:uppercase; letter-spacing:0.5px;">Descrição</label><textarea rows="3" onchange="VC.dados.metadados.descricao=this.value" style="width:100%; padding:10px 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; color:#1e293b; font-family:inherit; resize:vertical;" onfocus="this.style.borderColor=\'var(--primario)\'; this.style.outline=\'none\';" onblur="this.style.borderColor=\'#cbd5e1\';"></textarea></div>';

  h += '</div>';
  h += '</div>';

  // GRUPO 2: CONDICIONANTES AMBIENTAIS
  h += '<div style="background: var(--superf); border: 1px solid var(--borda); border-radius: 12px; padding: 20px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);">';
  h += '<div style="display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 700; color: var(--texto); border-bottom: 1px solid var(--borda); padding-bottom: 12px; margin-bottom: 20px;"><i class="fa-solid fa-cloud-sun" style="color: var(--primario); font-size: 16px;"></i> Condicionantes Ambientais</div>';

  h += '<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">';

  h += '<div><label style="display:block; font-size:11px; font-weight:700; color:#64748b; margin-bottom:6px; text-transform:uppercase; letter-spacing:0.5px;">Altitude (m)</label><input type="number" style="width:100%; padding:10px 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; color:#1e293b; text-align:right;" value="' + p.altitude + '" onchange="VC.dados.params.altitude=VC.utils.num(this.value); VC.perf.cacheFisica.invalidar(); VC.estado.sincronizar();" data-tt-simbolo="inputAltitude" onfocus="this.style.borderColor=\'var(--primario)\'; this.style.outline=\'none\';" onblur="this.style.borderColor=\'#cbd5e1\';"></div>';

  h += '<div><label style="display:block; font-size:11px; font-weight:700; color:#64748b; margin-bottom:6px; text-transform:uppercase; letter-spacing:0.5px;">Temperatura (°C)</label><input type="number" style="width:100%; padding:10px 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; color:#1e293b; text-align:right;" value="' + p.temperatura + '" onchange="VC.dados.params.temperatura=VC.utils.num(this.value); VC.perf.cacheFisica.invalidar(); VC.estado.sincronizar();" data-tt-simbolo="inputTemperatura" onfocus="this.style.borderColor=\'var(--primario)\'; this.style.outline=\'none\';" onblur="this.style.borderColor=\'#cbd5e1\';"></div>';

  h += '<div><label style="display:block; font-size:11px; font-weight:700; color:#64748b; margin-bottom:6px; text-transform:uppercase; letter-spacing:0.5px;">Humidade (%)</label><input type="number" style="width:100%; padding:10px 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; color:#1e293b; text-align:right;" value="' + p.humidade + '" onchange="VC.dados.params.humidade=VC.utils.num(this.value); VC.perf.cacheFisica.invalidar(); VC.estado.sincronizar();" data-tt-simbolo="inputHumidade" onfocus="this.style.borderColor=\'var(--primario)\'; this.style.outline=\'none\';" onblur="this.style.borderColor=\'#cbd5e1\';"></div>';

  h += '<div><label style="display:block; font-size:11px; font-weight:700; color:#64748b; margin-bottom:6px; text-transform:uppercase; letter-spacing:0.5px;">Rugosidade (mm)</label><input type="number" step="0.01" style="width:100%; padding:10px 12px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px; color:#1e293b; text-align:right;" value="' + p.rugosidade + '" onchange="VC.dados.params.rugosidade=VC.utils.num(this.value); VC.estado.sincronizar();" data-tt-simbolo="inputRugosidade" onfocus="this.style.borderColor=\'var(--primario)\'; this.style.outline=\'none\';" onblur="this.style.borderColor=\'#cbd5e1\';"></div>';

  h += '</div>';
  h += '</div>';

  h += '</div>';

  return h;
};
window._old_renderSetup_2 = function () {
