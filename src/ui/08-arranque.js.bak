  h += '<p style="font-size:11.5px;color:var(--texto-med);margin-bottom:15px">Definir o contexto do projeto. Estes dados alimentam o cálculo ISA/ar húmido em todas as fases.</p>';

  h += '<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">';

  h += '<div style="background: var(--superf2); border: 1px solid var(--borda); border-radius: 8px; padding: 16px; box-shadow: var(--sombra-1);">';
  h += '<div style="font-size: 11px; font-weight: 800; color: var(--primario-esc); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 12px; border-bottom: 1px solid var(--borda); padding-bottom: 8px;"><i class="fa-solid fa-folder-open"></i> Registo do Projeto</div>';
  h += '<div class="campo-grupo" style="margin-bottom: 10px;"><label>Nome do projeto</label><input value="' + VC.utils.esc(VC.dados.metadados.nome) + '" onchange="VC.dados.metadados.nome=this.value; VC.ui.renderSidebar();"></div>';
  h += '<div class="campo-grupo" style="margin-bottom: 10px;"><label>Cliente</label><input value="' + VC.utils.esc(VC.dados.metadados.cliente || '') + '" onchange="VC.dados.metadados.cliente=this.value"></div>';
  h += '<div class="campo-grupo" style="margin-bottom: 10px;"><label>Local</label><input value="' + VC.utils.esc(VC.dados.metadados.local || '') + '" onchange="VC.dados.metadados.local=this.value"></div>';
  h += '<div class="campo-grupo" style="margin-bottom: 10px;"><label>Autor</label><input value="' + VC.utils.esc(VC.dados.metadados.autor || '') + '" onchange="VC.dados.metadados.autor=this.value"></div>';
  h += '<div class="campo-grupo" style="margin-bottom: 0;"><label>Descrição</label><textarea rows="2" onchange="VC.dados.metadados.descricao=this.value" style="width:100%; resize:vertical; font-family:inherit; font-size:12px; padding:8px; border:1px solid var(--borda-media); border-radius:5px;">' + VC.utils.esc(VC.dados.metadados.descricao || '') + '</textarea></div>';
  h += '</div>';

  h += '<div style="background: var(--superf2); border: 1px solid var(--borda); border-radius: 8px; padding: 16px; box-shadow: var(--sombra-1);">';
  h += '<div style="font-size: 11px; font-weight: 800; color: var(--primario-esc); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 12px; border-bottom: 1px solid var(--borda); padding-bottom: 8px;"><i class="fa-solid fa-cloud-sun"></i> Condicionantes Ambientais</div>';
  h += '<div class="campo-grupo" style="margin-bottom: 10px;"><label>Altitude (m)</label><input type="number" style="width:100%" value="' + p.altitude + '" onchange="VC.dados.params.altitude=VC.utils.num(this.value); VC.perf.cacheFisica.invalidar(); VC.estado.sincronizar();" data-tt-simbolo="inputAltitude"></div>';
  h += '<div class="campo-grupo" style="margin-bottom: 10px;"><label>Temperatura (°C)</label><input type="number" style="width:100%" value="' + p.temperatura + '" onchange="VC.dados.params.temperatura=VC.utils.num(this.value); VC.perf.cacheFisica.invalidar(); VC.estado.sincronizar();" data-tt-simbolo="inputTemperatura"></div>';
  h += '<div class="campo-grupo" style="margin-bottom: 10px;"><label>Humidade (%)</label><input type="number" style="width:100%" value="' + p.humidade + '" onchange="VC.dados.params.humidade=VC.utils.num(this.value); VC.perf.cacheFisica.invalidar(); VC.estado.sincronizar();" data-tt-simbolo="inputHumidade"></div>';
  h += '<div class="campo-grupo" style="margin-bottom: 0;"><label>Rugosidade (mm)</label><input type="number" style="width:100%" step="0.01" value="' + p.rugosidade + '" onchange="VC.dados.params.rugosidade=VC.utils.num(this.value); VC.estado.sincronizar();" data-tt-simbolo="inputRugosidade"></div>';
  h += '</div>';

  h += '</div>';

  return h;
};
window._old_renderSetup = function () {
  const p = VC.dados.params;
  let h = '<div class="cartao-titulo"><i class="fa-solid fa-gear"></i> Setup do Projeto</div>';
  h += '<p style="font-size:11.5px;color:var(--texto-med);margin-bottom:10px">Definir o contexto do projeto. Estes dados alimentam o cálculo ISA/ar húmido em todas as fases.</p>';
  h += '<div class="grade-4" style="margin-bottom:12px">' + '<div class="campo-grupo"><label>Nome do projeto</label><input value="' + VC.utils.esc(VC.dados.metadados.nome) + '" onchange="VC.dados.metadados.nome=this.value; VC.ui.renderSidebar();"></div>' + '<div class="campo-grupo"><label>Cliente</label><input value="' + VC.utils.esc(VC.dados.metadados.cliente) + '" onchange="VC.dados.metadados.cliente=this.value"></div>' + '<div class="campo-grupo"><label>Local</label><input value="' + VC.utils.esc(VC.dados.metadados.local) + '" onchange="VC.dados.metadados.local=this.value"></div>' + '<div class="campo-grupo"><label>Autor</label><input value="' + VC.utils.esc(VC.dados.metadados.autor) + '" onchange="VC.dados.metadados.autor=this.value"></div>' + '</div>';
  h += '<div class="grade-4">' + '<div class="campo-grupo"><label>Altitude (m)</label><input type="number" value="' + p.altitude + '" onchange="VC.dados.params.altitude=VC.utils.num(this.value); VC.perf.cacheFisica.invalidar(); VC.estado.sincronizar();" data-tt-simbolo="inputAltitude"></div>' + '<div class="campo-grupo"><label>Temperatura (°C)</label><input type="number" value="' + p.temperatura + '" onchange="VC.dados.params.temperatura=VC.utils.num(this.value); VC.perf.cacheFisica.invalidar(); VC.estado.sincronizar();" data-tt-simbolo="inputTemperatura"></div>' + '<div class="campo-grupo"><label>Humidade (%)</label><input type="number" value="' + p.humidade + '" onchange="VC.dados.params.humidade=VC.utils.num(this.value); VC.perf.cacheFisica.invalidar(); VC.estado.sincronizar();" data-tt-simbolo="inputHumidade"></div>' + '<div class="campo-grupo"><label>Rugosidade (mm)</label><input type="number" step="0.01" value="' + p.rugosidade + '" onchange="VC.dados.params.rugosidade=VC.utils.num(this.value); VC.estado.sincronizar();" data-tt-simbolo="inputRugosidade"></div>' + '</div>';
  return h;
};

VC.caudalEspacoUI = {
  _filtroTexto: '',
  setFiltro: function(v) { this._filtroTexto = String(v || '').toLowerCase(); if(VC._passoAtivo === 'classificacao') VC.passos.render('classificacao'); },
  editar: function (idx, campo, valor) { const e = VC.dados.espacos[idx]; if (!e) return; if (['A', 'H', 'V', 'N'].indexOf(campo) >= 0) e[campo] = VC.utils.num(valor); else e[campo] = valor; VC.estado.sincronizar(); },
  setGrupo: function (idx, valor) {
    const e = VC.dados.espacos[idx]; if (!e) return;
    if (valor === 'auto') { delete e.grupoForcado; }
    else if (String(valor).indexOf('tipo:') === 0) { const novoTipo = String(valor).slice(5); if (VC.tiposEspaco && VC.tiposEspaco[novoTipo]) { e.tipo = novoTipo; delete e.grupoForcado; const def = VC.normas.getDef(novoTipo); e.Rp = def.rp; e.Ra = def.ra; if (e.rphOrigem !== 'utilizador' && VC.rph) VC.rph.reporNorma(e); else if (VC.rph) { const d = VC.rph.calcularDefault(e); e.rphDefault = d.rph; e.rphClasse = d.classe; e.rphClasseNome = d.classeNome; e.rphBase = d.base; } if (e.QAI_projeto_origem !== 'utilizador' && VC.qai) VC.qai.reporNorma(e); } }
    else { e.grupoForcado = Number(valor); if (e.rphOrigem !== 'utilizador' && VC.rph) VC.rph.reporNorma(e); }
    if (VC.editorEspacos) VC.editorEspacos._cacheOrdenacao = { chave: null, lista: null }; VC.estado.forcarSync(); if (VC._passoAtivo === 'classificacao') VC.passos.render('classificacao');
  },
  editarRPH: function (idx, valor) { const e = VC.dados.espacos[idx]; if (!e) return; const v = Math.max(0, VC.utils.num(valor)); VC.rph.aplicarUtilizador(e, v); VC.estado.sincronizar(); },
  reporNorma: function (idx) { const e = VC.dados.espacos[idx]; if (!e) return; VC.rph.reporNorma(e); VC.estado.sincronizar(); VC.ui.toast('RPH de «' + e.nome + '» reposto da norma (📘 · ' + e.rphAplicado + ' h⁻¹)'); },
  editarQAI: function (idx, valor) {
    const e = VC.dados.espacos[idx]; if (!e) return; const v = Math.max(0, VC.utils.num(valor));
    if (v === 0) { VC.qai.reporNorma(e); VC.estado.sincronizar(); VC.ui.toast('QAI de «' + e.nome + '» reposto (📘 norma · 0 m³/h)'); return; }
    if (!e.QAI_projeto_motivo || !String(e.QAI_projeto_motivo).trim()) { if (VC.popupQAI && VC.popupQAI.abrir) VC.popupQAI.abrir(idx, { valorForcado: v }); return; }
    const r = VC.qai.aplicarUtilizador(e, v, e.QAI_projeto_motivo, e.QAI_projeto_rede); if (!r.ok) { VC.ui.toast(r.erro); return; } VC.estado.sincronizar(); VC.ui.toast('QAI de «' + e.nome + '» → ' + v + ' m³/h (👷 engenheiro)');
  },
  reporNormaQAI: function (idx) { const e = VC.dados.espacos[idx]; if (!e) return; VC.qai.reporNorma(e); VC.estado.sincronizar(); VC.ui.toast('QAI de «' + e.nome + '» reposto (📘 norma · 0 m³/h)'); },
  ordenarPor: function (campo) { const ui = VC._espacosUI || {}; if (ui.ordenacao === campo) ui.direcao = ui.direcao === 'asc' ? 'desc' : 'asc'; else { ui.ordenacao = campo; ui.direcao = 'asc'; } if (VC.editorEspacos) VC.editorEspacos._cacheOrdenacao = { chave: null, lista: null }; if (VC._passoAtivo === 'classificacao') VC.passos.render('classificacao'); },
  _clicarLinha: function (idx) { if (!VC._espacosUI) VC._espacosUI = {}; VC._espacosUI.linhaAtiva = idx; if (VC._passoAtivo === 'classificacao') VC.passos.render('classificacao'); }
};

function _renderCaixaConceitoCaudal() {
  let h = '<div style="background:var(--primario-soft);border-left:3px solid var(--primario);color:var(--primario-esc);padding:12px 16px;border-radius:var(--raio-2);font-size:11.5px;line-height:1.6;margin-bottom:12px">';
  h += '<div style="font-weight:900;font-size:12.5px;margin-bottom:8px;color:var(--primario-esc)">📐 Como se calcula o caudal de cada espaço?</div><div style="margin-bottom:10px">O caudal final (<b>Q_total</b>) tem <b>3 parcelas</b>:</div><ol style="margin:0 0 10px 20px;padding:0"><li style="margin-bottom:4px"><b>Q_normas</b> — caudal obrigatório pela Portaria 138-I/2021</li><li style="margin-bottom:4px"><b>Q_ConTerm</b> — caudal de conforto térmico (F-RPH) = RPH × V</li><li style="margin-bottom:4px"><b>QAI_projeto</b> — caudal adicional definido pelo engenheiro (opcional)</li></ol>';
  h += '<div style="padding:6px 10px;background:var(--superf);border:1px solid var(--primario-borda);border-radius:5px;text-align:center;font-family:\'Cambria Math\',serif;font-size:13px;font-weight:800;color:var(--texto);margin-bottom:12px">Q_total = Q_normas + Q_ConTerm + QAI_projeto</div>';
  h += '<div style="font-weight:900;font-size:11.5px;margin-bottom:6px;color:var(--primario-esc)">📘 Siglas desta tabela:</div>';
  h += '<table style="width:100%;border-collapse:collapse;font-size:11px;background:var(--superf);border:1px solid var(--primario-borda);border-radius:5px;overflow:hidden;margin-bottom:12px"><thead><tr style="background:var(--superf3)"><th style="text-align:left;padding:6px 8px;font-weight:800;color:var(--texto-med);font-size:10px;text-transform:uppercase;letter-spacing:.3px;border-bottom:1px solid var(--primario-borda)">Sigla</th><th style="text-align:left;padding:6px 8px;font-weight:800;color:var(--texto-med);font-size:10px;text-transform:uppercase;letter-spacing:.3px;border-bottom:1px solid var(--primario-borda)">Significado</th><th style="text-align:left;padding:6px 8px;font-weight:800;color:var(--texto-med);font-size:10px;text-transform:uppercase;letter-spacing:.3px;border-bottom:1px solid var(--primario-borda)">Unidade</th></tr></thead><tbody>';
  const siglas = [ ['T11', 'Caudal mínimo de ar novo por ocupante', 'm³/(h·pessoa)'], ['T12', 'Caudal mínimo de ar novo por área útil', 'm³/(h·m²)'], ['T13', 'Caudal mínimo de extração (G4)', 'm³/h'], ['ACH', 'Renovações por hora', 'h⁻¹'], ['RPH', 'Renovações por hora de conforto (F-RPH)', 'h⁻¹'], ['ε_v', 'Eficácia de remoção de poluentes', '—'] ];
  siglas.forEach(function (s) { h += '<tr><td style="padding:5px 8px;font-family:\'Cambria Math\',serif;font-weight:800;color:var(--primario-esc);border-bottom:1px solid var(--borda);white-space:nowrap">' + s[0] + '</td><td style="padding:5px 8px;color:var(--texto);border-bottom:1px solid var(--borda)">' + s[1] + '</td><td style="padding:5px 8px;color:var(--texto-med);font-family:ui-monospace,monospace;font-size:10.5px;border-bottom:1px solid var(--borda)">' + s[2] + '</td></tr>'; });
  h += '</tbody></table><div style="font-weight:900;font-size:11.5px;margin-bottom:6px;color:var(--primario-esc)">📊 Grupos da Portaria 138-I/2021:</div>';
  h += '<table style="width:100%;border-collapse:collapse;font-size:11px;background:var(--superf);border:1px solid var(--primario-borda);border-radius:5px;overflow:hidden"><thead><tr style="background:var(--superf3)"><th style="text-align:left;padding:6px 8px;font-weight:800;color:var(--texto-med);font-size:10px;text-transform:uppercase;letter-spacing:.3px;border-bottom:1px solid var(--primario-borda);width:60px">Grupo</th><th style="text-align:left;padding:6px 8px;font-weight:800;color:var(--texto-med);font-size:10px;text-transform:uppercase;letter-spacing:.3px;border-bottom:1px solid var(--primario-borda)">Nome</th><th style="text-align:left;padding:6px 8px;font-weight:800;color:var(--texto-med);font-size:10px;text-transform:uppercase;letter-spacing:.3px;border-bottom:1px solid var(--primario-borda)">Tipos de espaço</th><th style="text-align:left;padding:6px 8px;font-weight:800;color:var(--texto-med);font-size:10px;text-transform:uppercase;letter-spacing:.3px;border-bottom:1px solid var(--primario-borda)">Regra de cálculo</th></tr></thead><tbody>';
  const cat = (VC.conhecimento && VC.conhecimento.categoriasPorGrupo) || {};
  const grupos = [ { g: 'G1', nome: 'Ocupação Permanente', tipos: ((cat[1] || []).length + ' tipos'), regra: 'max(T11·N, T12·A) / ε_v', cor: 'primario' }, { g: 'G2', nome: 'Zona de Transferência', tipos: ((cat[2] || []).length + ' tipos'), regra: 'Isento (Q_normas = 0)', cor: 'texto-med' }, { g: 'G3', nome: 'Baixa Emissão', tipos: ((cat[3] || []).length + ' tipos'), regra: 'max(T12·A, ACH·V) / ε_v', cor: 'ambar' }, { g: 'G4', nome: 'Extração Dedicada', tipos: ((cat[4] || []).length + ' tipos'), regra: 'T13 (regime-dependente)', cor: 'coral' } ];
  grupos.forEach(function (gr) { h += '<tr><td style="padding:6px 8px;border-bottom:1px solid var(--borda)"><span class="badge" style="background:var(--' + gr.cor + '-soft);color:var(--' + gr.cor + '-esc);border:1px solid var(--' + gr.cor + '-borda);font-weight:900">' + gr.g + '</span></td><td style="padding:6px 8px;font-weight:800;color:var(--texto);border-bottom:1px solid var(--borda)">' + gr.nome + '</td><td style="padding:6px 8px;color:var(--texto-med);border-bottom:1px solid var(--borda)">' + gr.tipos + '</td><td style="padding:6px 8px;font-family:\'Cambria Math\',serif;color:var(--texto);border-bottom:1px solid var(--borda)">' + gr.regra + '</td></tr>'; });
  h += '</tbody></table><div style="margin-top:10px;font-size:10.5px;color:var(--primario-esc);font-style:italic">💡 <b>Podes forçar o grupo</b> na coluna "Grupo" (override manual) — útil quando o tipo de espaço não corresponde exatamente à norma.</div></div>'; return h;
}

window.renderCaudalEspaco = function () {
  const ui = VC._espacosUI || { ordenacao: 'nome', direcao: 'asc', linhaAtiva: null }; const dis = VC.dados.congelado ? 'disabled' : '';
  let h = '<div class="cartao-titulo"><i class="fa-solid fa-tag"></i> Caudal por Espaço</div>'; h += _renderCaixaConceitoCaudal();
  if (!VC.dados.espacos.length) return h + '<div class="vazio"><i class="fa-solid fa-inbox"></i><div class="vazio-titulo">Sem espaços</div><div>Adiciona espaços no passo <b>Levantamento</b>.</div></div>';

  const filtroTexto = VC.caudalEspacoUI._filtroTexto || '';
  let espacosOrdenados = (VC.editorEspacos && VC.editorEspacos._ordenarListaComCache) ? VC.editorEspacos._ordenarListaComCache(VC.dados.espacos.slice(), ui.ordenacao, ui.direcao) : VC.dados.espacos.slice();
  if (filtroTexto) {
    espacosOrdenados = espacosOrdenados.filter(e => (e.nome || '').toLowerCase().includes(filtroTexto) || (e.tipo || '').toLowerCase().includes(filtroTexto));
  }
  const idxOriginal = new Map(); VC.dados.espacos.forEach((e, i) => idxOriginal.set(e, i));

  h += '<details class="tabela-progressiva" open style="margin-top:16px; background:var(--superf); border:1px solid var(--borda); border-radius:8px; padding:4px;"><summary style="cursor:pointer; font-weight:800; font-size:12px; color:var(--primario-esc); padding:8px; background:var(--superf3); border-radius:6px; list-style:none; display:flex; align-items:center; gap:6px; justify-content:space-between">';
  h += '<div style="display:flex; align-items:center; gap:6px"><i class="fa-solid fa-table-list"></i> Tabela Completa de Caudais</div>';
  h += '<div style="font-weight:400; font-size:11px; display:flex; gap:8px; align-items:center">';
  h += '<input type="text" placeholder="Pesquisar espaço..." value="' + VC.utils.esc(filtroTexto) + '" oninput="VC.caudalEspacoUI.setFiltro(this.value)" onclick="event.stopPropagation()" style="padding:4px 8px; border:1px solid var(--borda-media); border-radius:4px; width:200px; font-family:inherit">';
  h += '<span>' + espacosOrdenados.length + ' itens</span>';
  h += '</div></summary>';
  h += '<div style="margin-top:10px"></div>';
  h += '<div class="tabela-wrap"><table class="tabela densa"><thead><tr>';

  const colunas = [ { id: 'nome', label: 'Espaço', sortable: true }, { id: 'tipo', label: 'Tipo', sortable: true, width: '120px' }, { id: 'grupo', label: 'Grupo', sortable: false, width: '110px' }, { id: 'A', label: 'A (m²)', sortable: true, width: '70px' }, { id: 'H', label: 'H (m)', sortable: true, width: '60px' }, { id: 'V', label: 'V (m³)', sortable: true, width: '70px' }, { id: 'N', label: 'N (–)', sortable: true, width: '50px' }, { id: 'metodo', label: 'Método', sortable: false, width: '120px' }, { id: 'T11', label: 'T11', sortable: false, width: '60px' }, { id: 'T12', label: 'T12', sortable: false, width: '60px' }, { id: 'Q', label: 'Q_normas <span class="btn-help" data-tt="Q_normas" onclick="VC.tooltips.mostrar(\'Q_normas\', this)" style="cursor:pointer; background:#cbd5e1; color:#475569; border-radius:50%; padding:0 4px; font-size:9px; font-weight:900">?</span>', sortable: true, width: '100px' }, { id: 'RPH', label: 'RPH (h⁻¹)', sortable: false, width: '110px' }, { id: 'QConTerm', label: 'Q_ConTerm (m³/h)', sortable: false, width: '100px' }, { id: 'QAI', label: 'QAI_projeto (m³/h)', sortable: false, width: '110px' }, { id: 'Qtotal', label: 'Q_total <span class="btn-help" data-tt="Q_total" onclick="VC.tooltips.mostrar(\'Q_total\', this)" style="cursor:pointer; background:#cbd5e1; color:#475569; border-radius:50%; padding:0 4px; font-size:9px; font-weight:900">?</span>', sortable: false, width: '100px' }, { id: 'ACH', label: 'ACH (h⁻¹)', sortable: false, width: '70px' }, { id: 'estado', label: 'Estado', sortable: false, width: '60px' } ];

    h += '<th style="text-align:center;color:var(--texto-suave);font-weight:900;user-select:none">#</th>';
  colunas.forEach(col => { const ativa = ui.ordenacao === col.id; const seta = col.sortable ? (ativa ? (ui.direcao === 'asc' ? ' ▲' : ' ▼') : '') : ''; const cor = ativa ? 'color:var(--primario-esc)' : ''; const cursor = col.sortable ? 'cursor:pointer;user-select:none;' : ''; const onclick = col.sortable ? ' onclick="VC.caudalEspacoUI.ordenarPor(\'' + col.id + '\')"' : ''; const classeAttr = (col.classe || col.id === 'nome') ? ' class="col-flex"' : ''; const styleAttr = 'style="' + cursor + cor + '"'; h += '<th' + classeAttr + onclick + ' ' + styleAttr + '>' + col.label + seta + '</th>'; });
  h += '</tr></thead><tbody>';
    espacosOrdenados.forEach((e, ordemLinha) => {
    const idx = idxOriginal.get(e); const c = VC.calculo.calcularQEspaco(e); const grupoDerivado = c.g; const grupoForcado = e.grupoForcado; const corGrupo = { 1: 'var(--primario-esc)', 2: 'var(--texto-med)', 3: 'var(--ambar-esc)', 4: 'var(--coral-esc)' }; const metodo = c.metodoCaudal || '—'; const t11 = Number(c.def_T11) || 0; const t12 = Number(c.def_T12) || 0; const Q_normas = Number(c.Q_normas) || 0; const Q_ConTerm = Number(c.Q_ConTerm) || 0; const Q_total = Number(c.Q_total) || 0; const rphAplicado = Number(e.rphAplicado) || 0; const rphOrigem = e.rphOrigem || 'norma'; const temConf = Q_ConTerm > 0; const badge = temConf ? (rphOrigem === 'utilizador' ? '👤' : '📘') : ''; const qaiAplicado = Number(e.QAI_projeto) || 0; const qaiOrigem = e.QAI_projeto_origem || 'norma'; const qaiRede = e.QAI_projeto_rede || 'auto'; const qaiMotivo = e.QAI_projeto_motivo || ''; const temQAI = qaiAplicado > 0; const badgeQAI = temQAI ? (qaiOrigem === 'utilizador' ? '👷' : '📘') : ''; const linhaAtiva = (ui.linhaAtiva === idx); const classeLinha = linhaAtiva ? ' class="linha-ativa"' : '';
    h += '<tr' + classeLinha + ' data-idx="' + idx + '" onclick="this.closest(\'tbody\').querySelectorAll(\'tr\').forEach(r=>r.classList.remove(\'linha-destaque\'));this.classList.add(\'linha-destaque\'); VC.caudalEspacoUI._clicarLinha(' + idx + ')"><td>' + VC.utils.esc(e.nome) + '</td><td style="font-size:10.5px">' + VC.utils.esc(e.tipo) + '</td>';
    const nomesGrupoOpt = { 1: 'G1 · Ocupação Permanente', 2: 'G2 · Zona de Transferência', 3: 'G3 · Baixa Emissão', 4: 'G4 · Extração Dedicada' }; const mapaGrupos36 = { 1: [], 2: [], 3: [], 4: [] };
    Object.keys(VC.tiposEspaco || {}).forEach(tKey => { const gNum = (VC.tiposEspaco[tKey] && VC.tiposEspaco[tKey].g) || 1; if (!mapaGrupos36[gNum]) mapaGrupos36[gNum] = []; mapaGrupos36[gNum].push(tKey); }); [1, 2, 3, 4].forEach(gNum => { mapaGrupos36[gNum].sort((a, b) => a.localeCompare(b, 'pt-PT')); });
    h += '<td><select onchange="VC.caudalEspacoUI.setGrupo(' + idx + ', this.value)" onclick="event.stopPropagation()" style="width:100%;padding:2px 5px;border:1px solid var(--borda-media);border-radius:4px;font-size:10.5px;font-family:inherit;background:#fff;color:' + corGrupo[grupoForcado || grupoDerivado] + ';font-weight:800" ' + dis + '><option value="auto"' + (!grupoForcado ? ' selected' : '') + '>G' + grupoDerivado + ' · ' + VC.utils.esc(e.tipo) + ' (auto)</option>';
    [1, 2, 3, 4].forEach(gNum => { const listaT = mapaGrupos36[gNum] || []; h += '<optgroup label="' + nomesGrupoOpt[gNum] + ' (' + listaT.length + ')">'; listaT.forEach(tNome => { const isSel = (!grupoForcado && e.tipo === tNome) ? ' selected' : ''; h += '<option value="tipo:' + VC.utils.esc(tNome) + '"' + isSel + '>G' + gNum + ' · ' + VC.utils.esc(tNome) + '</option>'; }); h += '</optgroup>'; });
    h += '<optgroup label="Forçar apenas Grupo (Override)"><option value="1"' + (grupoForcado === 1 ? ' selected' : '') + '>G1 · Forçar Ocupação Permanente</option><option value="2"' + (grupoForcado === 2 ? ' selected' : '') + '>G2 · Forçar Zona de Transferência</option><option value="3"' + (grupoForcado === 3 ? ' selected' : '') + '>G3 · Forçar Baixa Emissão</option><option value="4"' + (grupoForcado === 4 ? ' selected' : '') + '>G4 · Forçar Extração Dedicada</option></optgroup></select></td>';
        h += '<td><input class="num-1d" type="number" step="0.01" value="' + VC.utils.fmt(c.A, 1) + '" onchange="VC.caudalEspacoUI.editar(' + idx + ', \'A\', this.value)" onclick="event.stopPropagation()" style="padding:3px 5px;border:1px solid var(--borda-media);border-radius:4px;font-size:10.5px" ' + dis + '></td>';
        h += '<td><input class="num-2d" type="number" step="0.1" value="' + VC.utils.fmt(c.H, 1) + '" onchange="VC.caudalEspacoUI.editar(' + idx + ', \'H\', this.value)" onclick="event.stopPropagation()" style="padding:3px 5px;border:1px solid var(--borda-media);border-radius:4px;font-size:10.5px" ' + dis + '></td>';
        h += '<td><input class="num-2d-longo" type="number" step="0.1" value="' + VC.utils.fmt(c.V, 1) + '" onchange="VC.caudalEspacoUI.editar(' + idx + ', \'V\', this.value)" onclick="event.stopPropagation()" style="padding:3px 5px;border:1px solid var(--borda-media);border-radius:4px;font-size:10.5px" ' + dis + '></td>';
        h += '<td><input class="num-int" type="number" value="' + (c.N || 0) + '" onchange="VC.caudalEspacoUI.editar(' + idx + ', \'N\', this.value)" onclick="event.stopPropagation()" style="padding:3px 5px;border:1px solid var(--borda-media);border-radius:4px;font-size:10.5px" ' + dis + '></td>';
    h += '<td style="font-size:10px;color:var(--texto-med);white-space:nowrap">' + VC.utils.esc(metodo.length > 18 ? metodo.substring(0, 16) + '…' : metodo) + '</td>';
    h += '<td style="font-family:ui-monospace,monospace;font-size:10.5px;text-align:right">' + (t11 > 0 ? VC.utils.fmt(t11, 1) : '—') + '</td>';
    h += '<td style="font-family:ui-monospace,monospace;font-size:10.5px;text-align:right">' + (t12 > 0 ? VC.utils.fmt(t12, 1) : '—') + '</td>';
    h += '<td><span class="valor-derivado" style="font-weight:900">' + VC.utils.fmt(Q_normas, 0) + '</span></td>';
        const rphHTML = '<div style="display:flex;gap:3px;align-items:center"><input class="num-1d" type="number" step="0.1" min="0" value="' + rphAplicado + '" onchange="VC.caudalEspacoUI.editarRPH(' + idx + ', this.value)" onclick="event.stopPropagation()" ' + dis + ' style="padding:2px 4px;border:1px solid var(--borda-media);border-radius:3px;font-size:10.5px;font-family:inherit">' + (badge ? '<span style="font-size:11px">' + badge + '</span>' : '') + (rphOrigem === 'utilizador' ? '<button class="btn btn-mini" onclick="event.stopPropagation(); VC.caudalEspacoUI.reporNorma(' + idx + ')" ' + dis + ' style="padding:0 3px;font-size:9px" title="Repor norma">↺</button>' : '') + '</div>';
    h += '<td>' + rphHTML + '</td>';
    h += '<td><span class="valor-derivado" style="' + (temConf ? 'background:var(--primario-soft);color:var(--primario-esc)' : '') + '">' + VC.utils.fmt(Q_ConTerm, 0) + '</span></td>';
    let qaiCellHTML = '<div style="display:flex;gap:3px;align-items:center;flex-wrap:nowrap">';
        qaiCellHTML += '<input class="num-int-longo" type="number" step="1" min="0" value="' + qaiAplicado + '" onchange="VC.caudalEspacoUI.editarQAI(' + idx + ', this.value)" onclick="event.stopPropagation()" ' + dis + ' title="QAI projeto · ' + qaiOrigem + (temQAI && qaiMotivo ? ' · ' + VC.utils.esc(qaiMotivo) : '') + '" style="padding:2px 4px;border:1px solid var(--borda-media);border-radius:3px;font-size:10.5px;font-family:inherit' + (temQAI ? ';background:#faf3e8;font-weight:800;color:#8a6a3a' : '') + '">';
    if (badgeQAI) { qaiCellHTML += '<button class="btn btn-mini" onclick="event.stopPropagation(); if(VC.popupQAI)VC.popupQAI.abrir(' + idx + ')" title="' + (qaiOrigem === 'utilizador' ? 'QAI definido pelo engenheiro' : 'QAI da norma') + ' · ' + qaiRede + '" style="padding:0 3px;font-size:10px;border:1px solid ' + (qaiOrigem === 'utilizador' ? '#b88a4a' : '#7fa88b') + ';background:' + (qaiOrigem === 'utilizador' ? '#faf3e8' : '#eef5f0') + '">' + badgeQAI + '</button>'; }
    else { qaiCellHTML += '<button class="btn btn-mini" onclick="event.stopPropagation(); if(VC.popupQAI)VC.popupQAI.abrir(' + idx + ')" title="Definir QAI projeto" style="padding:0 3px;font-size:9px;opacity:.5">+</button>'; }
    if (qaiOrigem === 'utilizador') { qaiCellHTML += '<button class="btn btn-mini" onclick="event.stopPropagation(); VC.caudalEspacoUI.reporNormaQAI(' + idx + ')" ' + dis + ' title="Repor norma (QAI = 0)" style="padding:0 3px;font-size:9px">↺</button>'; }
    qaiCellHTML += '</div>';
    h += '<td>' + qaiCellHTML + '</td>';
    h += '<td><span class="valor-derivado" style="font-weight:900;color:var(--primario-esc)">' + VC.utils.fmt(Q_total, 0) + '</span></td>';
    h += '<td style="font-family:ui-monospace,monospace;font-size:10.5px;text-align:right">' + VC.utils.fmt(c.ACH, 2) + '</td>';
    h += '<td>' + (c.status === 'OK' ? '<span class="badge ok">✅</span>' : '<span class="badge erro">❌</span>') + '</td></tr>';
  });
  h += '</tbody></table></div></details>';

  const temRPHGlobal = VC.dados.espacos.some(e => (Number(e.Q_ConTerm) || 0) > 0); const temQAIGlobal = VC.dados.espacos.some(e => (Number(e.QAI_projeto) || 0) > 0);
  if (temRPHGlobal || temQAIGlobal) { h += '<div style="margin-top:10px;padding:8px 12px;background:var(--primario-soft);border-left:3px solid var(--primario);border-radius:5px;font-size:10.5px;color:var(--primario-esc);line-height:1.55">'; if (temRPHGlobal) { h += '<b>📘 RPH norma</b> — calculado automaticamente (EN 16798-1 + ASHRAE 55). <b>👤 RPH utilizador</b> — alterado manualmente. <b>↺</b> — repor norma.<br>'; } if (temQAIGlobal) { h += '<b>📘 QAI norma</b> — QAI = 0 (por omissão). <b>👷 QAI engenheiro</b> — definido com motivo auditável. <b>↺</b> — repor QAI = 0.<br>'; } h += '<b>Q_total = Q_normas + Q_ConTerm + QAI_projeto</b></div>'; }
  return h;
};

window.renderOtimizacao = function () {
  const hist = VC.dados.historicoConvergencia || [];
  let h = '<div class="cartao-titulo"><i class="fa-solid fa-wand-magic-sparkles"></i> Optimização Automática</div>';
  h += '<p style="font-size:11.5px;color:var(--texto-med);margin-bottom:12px">Ajusta Ø para R=1 Pa/m, corrige v > limite, ajusta ζ. Máx 10 iterações. Respeita lock de Ø.</p>';

  if (hist.length === 0) {
    h += '<div class="vazio" style="padding:40px; border:1px dashed var(--borda-media); border-radius:8px; background:var(--superf2);">';
    h += '<i class="fa-solid fa-wand-magic-sparkles" style="font-size:40px; color:var(--primario); opacity:0.5; margin-bottom:12px; display:block;"></i>';
    h += '<div class="vazio-titulo" style="font-size:15px; color:var(--texto); margin-bottom:8px;">A rede ainda não foi otimizada</div>';
    h += '<div style="color:var(--texto-suave); font-size:12px; margin-bottom:16px;">O sistema irá ajustar os diâmetros comerciais e os coeficientes de perda para equilibrar a rede.</div>';
    h += '<button class="btn primario btn-large" onclick="VC.optimizar.executar()"><i class="fa-solid fa-play"></i> Executar Optimização</button>';
    h += '</div>';
  } else {
    h += '<div style="display:flex; gap:10px; margin-bottom:14px;">';
    h += '<button class="btn primario" onclick="VC.optimizar.executar()"><i class="fa-solid fa-rotate-right"></i> Re-executar Optimização</button>';
    h += '</div>';

    h += '<div style="border:1px solid var(--borda);border-radius:8px;overflow:hidden">';
    h += '<div style="padding:10px 14px;background:var(--superf3);font-size:10.5px;font-weight:900;text-transform:uppercase;color:var(--texto-med);border-bottom:1px solid var(--borda);display:grid;grid-template-columns:50px 1fr 100px 100px 80px;gap:10px">';
    h += '<span>Iteração</span><span>Ações</span><span style="text-align:right">Δp Máx</span><span style="text-align:right">Desvio</span><span style="text-align:right">Estado</span>';
    h += '</div>';

    hist.forEach(it => {
      const ok = it.convergiu;
      const desvioPct = Math.round(it.maxDesvio * 100);
      const corDesvio = desvioPct <= 20 ? 'var(--verde-esc)' : (desvioPct <= 35 ? 'var(--ambar-esc)' : 'var(--coral-esc)');
      h += `<div style="display:grid;grid-template-columns:50px 1fr 100px 100px 80px;gap:10px;align-items:center;padding:10px 14px;border-bottom:1px solid var(--borda);font-size:11.5px;font-family:ui-monospace,monospace">`;
      h += `<span style="font-weight:900;color:var(--primario-esc)">#${it.iter}</span>`;
      h += `<span style="color:var(--texto-med)">${(it.acoes.join(' · ') || '—')}</span>`;
      h += `<span style="text-align:right;font-weight:800">${VC.utils.fmt(it.maxDP, 0)} Pa</span>`;
      h += `<span style="text-align:right;font-weight:800;color:${corDesvio}">${desvioPct}%</span>`;
      h += `<span style="text-align:right;font-weight:900;color:${ok ? 'var(--verde-esc)' : 'var(--ambar-esc)'}">${ok ? '✅ OK' : '⏳ ...'}</span>`;
      h += `</div>`;
    });
    h += '</div>';
  }
  return h;
};

window.renderNormativa = function () { const x = VC.calculo.calcularTudo(); const legais = VC.normativaUI.verificacoesLegais(x); const refs = VC.normativaUI.verificacoesReferencia(x); let h = '<div class="cartao-titulo"><i class="fa-solid fa-scale-balanced"></i> Verificação Normativa</div><div style="padding:10px 14px;border-radius:6px;background:var(--' + (x.overall === 'CONFORME' ? 'verde-soft' : (x.overall === 'ATENÇÃO' ? 'ambar-soft' : 'coral-soft')) + ');border-left:3px solid var(--' + (x.overall === 'CONFORME' ? 'verde' : (x.overall === 'ATENÇÃO' ? 'ambar' : 'coral')) + ');font-weight:800;font-size:12.5px;margin-bottom:12px">Estado global: ' + x.overall + '</div><div class="tabela-wrap" style="margin-bottom:14px"><table class="tabela"><thead><tr><th>Norma</th><th>Item</th><th>Resultado</th><th style="width:110px">Estado</th></tr></thead><tbody>'; legais.forEach(v => { let badge; if (v.estado === 'CONFORME') badge = '<span class="badge ok">✅</span>'; else if (v.estado === 'ATENÇÃO') badge = '<span class="badge atencao">⚠️</span>'; else if (v.estado === 'INFORMATIVO') badge = '<span class="badge info">ℹ️</span>'; else badge = '<span class="badge erro">❌</span>'; h += '<tr><td><b>' + VC.utils.esc(v.norma) + '</b></td><td>' + VC.utils.esc(v.item) + '</td><td>' + VC.utils.esc(v.resultado) + '</td><td>' + badge + '</td></tr>'; }); h += '</tbody></table></div><div class="cartao-titulo" style="margin-top:14px"><i class="fa-solid fa-book"></i> Referências</div><div class="tabela-wrap"><table class="tabela densa"><thead><tr><th>Norma</th><th>Item</th><th>Resultado</th></tr></thead><tbody>'; refs.forEach(v => { h += '<tr><td>' + VC.utils.esc(v.norma) + '</td><td>' + VC.utils.esc(v.item) + '</td><td>' + VC.utils.esc(v.resultado) + '</td></tr>'; }); h += '</tbody></table></div>'; return h; };

window.renderDiagnostico = function () { const r = VC6.testes.correr(); let h = '<div class="cartao-titulo"><i class="fa-solid fa-vial"></i> Diagnóstico · ' + r.total + ' testes</div>' + VC.ui_comp.kpiGrid([ { l: 'Total', v: r.total, cor: 'primario' }, { l: 'Passados', v: r.pass, cor: 'verde' }, { l: 'Falhados', v: r.fail, cor: 'coral' }, { l: 'Taxa', v: (r.total ? Math.round(r.pass / r.total * 100) : 0) + ' %', cor: 'violeta' } ], 4) + '<button class="btn primario" onclick="VC.ui.abrirTestes()"><i class="fa-solid fa-vial"></i> Abrir painel detalhado</button> ' + '<button class="btn" onclick="VC.utils.downloadJSON(\'diagnostico_v' + VC.versaoCurta + '.json\', VC6.testes.exportarDiagnostico());"><i class="fa-solid fa-file-code"></i> Exportar</button>'; return h; };

window.renderRelatoriosAtalho = function () {
  let h = '<div class="cartao-titulo"><i class="fa-solid fa-file-lines"></i> Relatórios Técnicos ' + VC.versao + '</div>';
  h += '<p style="font-size:11.5px;color:var(--texto-med);margin-bottom:14px">Selecione um dos relatórios para visualizar, imprimir ou exportar em PDF/Excel.</p>';

  const lista = VC.listaRelatorios || [];
  h += '<div style="display:grid;grid-template-columns:repeat(auto-fill, minmax(180px, 1fr));gap:12px;">';
  lista.forEach(r => {
    h += `<div class="cartao" style="cursor:pointer;padding:16px;display:flex;flex-direction:column;align-items:center;text-align:center;transition:transform .15s, box-shadow .15s; border:1px solid var(--borda-media);" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='var(--sombra-3)';this.style.borderColor='var(--primario)';" onmouseout="this.style.transform='';this.style.boxShadow='var(--sombra-1)';this.style.borderColor='var(--borda-media)';" onclick="VC.modoRelatorios.set('${r.id}'); VC.modos.set('relatorios');">`;
    h += `<div style="width:48px;height:48px;border-radius:50%;background:var(--primario-soft);color:var(--primario-esc);display:flex;align-items:center;justify-content:center;font-size:20px;margin-bottom:12px;"><i class="fa-solid ${r.icone}"></i></div>`;
    h += `<div style="font-weight:800;font-size:13px;color:var(--texto);margin-bottom:4px;">${VC.utils.esc(r.titulo)}</div>`;
    h += `<div style="font-size:10.5px;color:var(--texto-suave);">Abrir relatório</div>`;
    h += `</div>`;
  });
  h += '</div>';

  h += '<div style="margin-top:20px; display:flex; gap:8px; justify-content:center;">';
  h += '<button class="btn coral btn-large" onclick="VC.exportacoes.pdf()"><i class="fa-solid fa-file-pdf"></i> Exportar PDF Completo</button>';
  h += '<button class="btn verde btn-large" onclick="VC.exportacoes.excel()"><i class="fa-solid fa-file-excel"></i> Exportar Excel</button>';
  h += '</div>';

  return h;
};

window.renderCaderno = function () { return '<div class="cartao-titulo"><i class="fa-solid fa-clipboard"></i> Caderno de Encargos ' + VC.versao + '</div><div class="vazio"><i class="fa-solid fa-clipboard"></i><div class="vazio-titulo">Caderno parametrizado · 14 secções</div><div>Inclui secção 14 · F-RPH · Conforto térmico · QAI_projeto</div><div class="vazio-acoes"><button class="btn primario btn-large" onclick="VC.caderno.abrir()"><i class="fa-solid fa-eye"></i> Ver caderno</button><button class="btn coral btn-large" onclick="VC.caderno.exportarPDF()"><i class="fa-solid fa-file-pdf"></i> Exportar PDF</button></div></div>'; };

window.renderConfig = function () {
  let h = '<div class="cartao-titulo"><i class="fa-solid fa-sliders"></i> Configurações do Sistema ' + VC.versao + '</div>';
  h += '<p style="font-size:12px;color:var(--texto-med);margin-bottom:24px">Faça a gestão dos parâmetros, flags e definições avançadas do motor lógico. Selecione o painel pretendido para aceder às opções.</p>';
  h += '<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px;">';
  
  h += '<div class="cartao" style="padding:20px; display:flex; flex-direction:column; gap:12px; border:1px solid var(--borda-media); border-top:4px solid var(--primario); box-shadow: var(--sombra-1); border-radius: 8px; transition: transform .15s, box-shadow .15s;" onmouseover="this.style.transform=\'translateY(-2px)\';this.style.boxShadow=\'var(--sombra-3)\';" onmouseout="this.style.transform=\'\';this.style.boxShadow=\'var(--sombra-1)\';">';
  h += '<div style="display:flex; align-items:center; gap:12px;"><div style="width:42px;height:42px;border-radius:50%;background:var(--primario-soft);color:var(--primario-esc);display:flex;align-items:center;justify-content:center;font-size:18px;"><i class="fa-solid fa-sliders"></i></div><div style="font-weight:800; font-size:14px; color:var(--texto);">Flags & Parâmetros</div></div>';
  h += '<p style="font-size:11.5px; color:var(--texto-med); flex:1; margin:0; line-height:1.5;">Aceda aos 11 grupos de configuração do sistema, incluindo as opções para o Conforto Térmico (F-RPH), QAI de projeto e as definições avançadas da topologia facetada.</p>';
  h += '<button class="btn primario" onclick="VC.configuracoes.abrir()" style="align-self:flex-start; margin-top:8px;"><i class="fa-solid fa-sliders"></i> Abrir Configurações</button>';
  h += '</div>';

  h += '<div class="cartao" style="padding:20px; display:flex; flex-direction:column; gap:12px; border:1px solid var(--borda-media); border-top:4px solid var(--violeta, #8b5cf6); box-shadow: var(--sombra-1); border-radius: 8px; transition: transform .15s, box-shadow .15s;" onmouseover="this.style.transform=\'translateY(-2px)\';this.style.boxShadow=\'var(--sombra-3)\';" onmouseout="this.style.transform=\'\';this.style.boxShadow=\'var(--sombra-1)\';">';
  h += '<div style="display:flex; align-items:center; gap:12px;"><div style="width:42px;height:42px;border-radius:50%;background:var(--violeta-soft, #ede9fe);color:var(--violeta-esc, #6d28d9);display:flex;align-items:center;justify-content:center;font-size:18px;"><i class="fa-solid fa-vial"></i></div><div style="font-weight:800; font-size:14px; color:var(--texto);">Ambiente de Testes</div></div>';
  h += '<p style="font-size:11.5px; color:var(--texto-med); flex:1; margin:0; line-height:1.5;">Abra a framework de testes internos para auditar o comportamento dos módulos lógicos, motores físicos e a fiabilidade da migração dos dados.</p>';
  h += '<button class="btn" onclick="VC.ui.abrirTestes()" style="align-self:flex-start; margin-top:8px; background:var(--violeta, #8b5cf6); color:#fff; border-color:var(--violeta, #8b5cf6);"><i class="fa-solid fa-vial"></i> Painel de Testes</button>';
  h += '</div>';
  
  h += '</div>';
  return h;
};

function bootstrapFinal() {
  try {
    const inicio = performance.now ? performance.now() : Date.now(); if (!VC.catalogo.hierarquia.length) VC.catalogo.init(); if (VC.exemplos && typeof VC.exemplos.init === 'function') VC.exemplos.init(); VC.atualizarVersaoNaUI();
    if (!VC.dados.espacos.length) { if (typeof VC.carregarDegradeTorresVedras === 'function') VC.carregarDegradeTorresVedras(); else if (typeof VC.exemploV6 === 'function') VC.exemploV6(); else if (typeof VC.exemplo === 'function') VC.exemplo(); }
    else { VC.calculo.migrarRedes(); if (VC.rph && VC.rph.aplicarATodos) VC.rph.aplicarATodos(); if (VC.qai && VC.qai.aplicarATodos) VC.qai.aplicarATodos(); VC.calculo.calcularTudo(); if (VC6.balanco) VC6.balanco.propagar(); }
    VC.ui.renderSidebar(); if (VC.passos && typeof VC.passos.render === 'function') VC.passos.render('setup'); VC.modos.set('condutas'); if (VC.tooltips) VC.tooltips.instalar();

    if (VC.eventos) {
      VC.eventos.on('calculo:inicio', () => {
        let bar = document.getElementById('vc-status-bar');
        if (bar) bar.innerHTML = '<i class="fa-solid fa-spinner fa-spin" style="color:var(--primario)"></i> <span style="color:var(--texto-med)">A recalcular...</span>';
      });
      VC.eventos.on('calculo:fim', (x) => {
        let bar = document.getElementById('vc-status-bar');
        if (!bar) return;
        const n = (x && x.findings) ? x.findings.length : 0;
        const est = (x && x.overall) ? x.overall : 'CONFORME';
        const cor = est === 'CONFORME' ? 'var(--verde-esc)' : (est === 'ATENÇÃO' ? 'var(--ambar-esc)' : 'var(--coral-esc)');
        bar.innerHTML = `<span style="color:${cor}; font-weight:900;">✓ ${est}</span> <span style="color:var(--texto-med); opacity:0.7; margin-left:6px;">· ${n} findings</span>`;
      });
    }
    const topoAcoes = document.querySelector('.topo-acoes');
    if (topoAcoes && !document.getElementById('vc-status-bar')) {
      const statusBar = document.createElement('div');
      statusBar.id = 'vc-status-bar';
      statusBar.style.cssText = 'display:inline-flex; align-items:center; font-size:11px; padding:4px 10px; border-radius:20px; background:var(--superf2); border:1px solid var(--borda-media); margin-right:8px; white-space:nowrap;';
      topoAcoes.insertBefore(statusBar, topoAcoes.firstChild);

      setTimeout(() => { if (VC.eventos) VC.eventos.emit('calculo:fim', VC.calculo.ultimo); }, 100);
    }

    const urlParams = new URLSearchParams(window.location.search); if (urlParams.get('layout') === '2') { VC.flags.layoutV2 = true; }
    if (VC.flags.layoutV2) { const jb = document.querySelector('.janelas-bar'); const lb = document.querySelector('.lens-bar'); const bm = document.querySelector('.barra-modos'); if (jb) jb.style.display = 'flex'; if (lb) lb.style.display = 'flex'; if (bm) bm.style.display = 'none'; }
    document.addEventListener('keydown', function (ev) {
      const t = ev.target; const emInput = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
      if (emInput && (ev.ctrlKey || ev.metaKey) && (ev.key === 'z' || ev.key === 'y' || ev.key === 'Z' || ev.key === 'Y')) return;
      const atalhos = VC.conhecimento.atalhos || {}; let chave = ''; if (ev.ctrlKey || ev.metaKey) chave += 'ctrl+'; if (ev.shiftKey) chave += 'shift+'; chave += ev.key.toLowerCase(); const a = atalhos[chave];
      if (a && a.acao) { const acoes = { guardar: () => VC.ui.guardar(), guardarComo: () => VC.ui.guardarComo(), abrir: () => VC.ui.abrir(), exemplos: () => VC.exemplos.abrirModal(), pdf: () => VC.exportacoes.pdf(), testes: () => VC.ui.abrirTestes(), diagrama: () => VC.modos.set('diagrama-rede'), pesquisa: () => { const inp = document.getElementById('pesquisaGlobal'); if (inp) inp.focus(); }, fechar: () => { VC.ui.fecharModal(); if (VC.tooltips) VC.tooltips.esconder(); } }; if (acoes[a.acao]) { ev.preventDefault(); acoes[a.acao](); return; } }
      if (ev.key === 'Escape') { VC.ui.fecharModal(); if (VC.tooltips) VC.tooltips.esconder(); }
    });
    const nComConforto = (VC.dados.espacos || []).filter(e => (Number(e.Q_ConTerm) || 0) > 0).length; const nComQAI = (VC.dados.espacos || []).filter(e => (Number(e.QAI_projeto) || 0) > 0).length; const qaiTotal = (VC.dados.espacos || []).reduce((s, e) => s + (Number(e.QAI_projeto) || 0), 0);
    const contagens = { versao: 'V9.2.0-layout-fase4.1', espacos: VC.dados.espacos.length, comConforto: nComConforto, comQAI: nComQAI, qaiTotal: Math.round(qaiTotal), definicoes: VC.dados.espacos.reduce((s, e) => s + ((e.definicoes || []).length), 0), terminais: VC.dados.terminais.length, ramais: VC.dados.ramais.length, transferencias: (VC.dados.transferencias || []).length, utas: VC.dados.utas.length, tooltips: (VC.conhecimento.tooltips) ? Object.keys(VC.conhecimento.tooltips).length : 0, conceitos: (VC.conhecimento.conceitos) ? Object.keys(VC.conhecimento.conceitos).length : 0, curvas: (VC.conhecimento.curvasFabricantes) ? VC.conhecimento.curvasFabricantes.length : 0, catalogo: (VC.conhecimento.catalogoTerminais) ? VC.conhecimento.catalogoTerminais.length : 0, tiposEspaco: (VC.conhecimento.tiposEspaco) ? Object.keys(VC.conhecimento.tiposEspaco).length : 0 };
    const dur = Math.round((performance.now ? performance.now() : Date.now()) - inicio); console.log('%c╔══════════════════════════════════════════════════════════════╗', 'color:#6d8fb0;font-weight:bold'); console.log('%c║  VentCondutas V9.2.0 · Layout V2 Fase 4.1 (Infra Hasse)     ║', 'color:#6d8fb0;font-weight:bold;font-size:13px'); console.log('%c╚══════════════════════════════════════════════════════════════╝', 'color:#6d8fb0;font-weight:bold'); console.table(contagens); console.log('%c⏱  Bootstrap: ' + dur + ' ms', 'color:#7fa88b;font-weight:bold'); console.log('%c📦 Partes: ' + VC._boot.partes.join(' → '), 'color:#9488b8;font-weight:bold'); if (nComQAI > 0) { console.log('%c👷 QAI_projeto ativo em ' + nComQAI + ' espaço(s) · total ' + Math.round(qaiTotal) + ' m³/h', 'color:#b88a4a;font-weight:bold'); } if (VC.snap) { console.log('%c🔗 Snap V9 ativo · Ctrl+Z desfaz · Ctrl+Y refaz', 'color:#6d8fb0;font-weight:bold'); } console.log('%c🎨 Lente Hasse: placeholder (implementação real em 4.2)', 'color:#7fa88b;font-weight:bold');
  } catch (e) { console.error('[VentCondutas V11.0.0 · Fase 4.1] Erro no bootstrap:', e); if (VC.debug) VC.debug.erro(e); }
}
window.bootstrapFinal = bootstrapFinal;
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function () { setTimeout(bootstrapFinal, 50); }); else setTimeout(bootstrapFinal, 50);

(function installLayoutV2Integrations() {
  if (typeof VC.ui.renderSidebar === 'function' && !VC.ui._renderSidebarWrapped) {
    var _renderSidebarOriginal = VC.ui.renderSidebar;
    VC.ui.renderSidebar = function () { var r = _renderSidebarOriginal.apply(this, arguments); if (VC.flags.layoutV2 && VC.layoutV2 && VC.layoutV2.janelaAtiva) { setTimeout(function () { VC.layoutV2._aplicarFiltroSidebar(); }, 0); } return r; };
    VC.ui._renderSidebarWrapped = true;
  }
  if (VC.passos && typeof VC.passos.render === 'function' && !VC.passos._renderLensWrapped) {
    var _renderOriginal = VC.passos.render;
    VC.passos.render = function () { if (VC.flags.layoutV2 && VC.flags.layoutV2Lente !== 'passo') { VC.flags.layoutV2Lente = 'passo'; document.querySelectorAll('.lente-btn').forEach(function (b) { b.classList.toggle('ativo', b.dataset.lente === 'passo'); }); } return _renderOriginal.apply(this, arguments); };
    VC.passos._renderLensWrapped = true;
  }
  function inicializarLayoutV2(tentativa) {
    tentativa = tentativa || 0; if (!VC.flags.layoutV2) return; if (!VC.layoutV2) return; var sidebar = document.getElementById('sidebar'); if (!sidebar || !sidebar.children.length) { if (tentativa < 20) setTimeout(function () { inicializarLayoutV2(tentativa + 1); }, 100); return; }
    var urlParams = new URLSearchParams(window.location.search); var janelaNum = Number(urlParams.get('janela')) || null; var lente = urlParams.get('lente') || null;
    if (!janelaNum) { try { var saved = window.localStorage.getItem('VC_layoutV2_janela'); if (saved) janelaNum = Number(saved); } catch (e) {} }
    if (!lente) { try { var savedL = window.localStorage.getItem('VC_layoutV2_lente'); if (savedL) lente = savedL; } catch (e) {} }
    if (!lente || lente === 'visual') lente = 'passo';
    if (!janelaNum) { var passoAtivo = VC._passoAtivo || 'setup'; var janela = VC.layoutV2.JANELAS.filter(function (j) { return j.passos.indexOf(passoAtivo) >= 0; })[0]; janelaNum = janela ? janela.num : 1; }
    var lensBar = document.querySelector('.lens-bar');
    if (lensBar && !lensBar.querySelector('.lente-btn[data-lente="passo"]')) { lensBar.innerHTML = '<span style="font-size:10px;font-weight:900;text-transform:uppercase;color:var(--texto-suave);letter-spacing:0.5px;margin-right:4px">Lente</span><button class="lente-btn ativo" data-lente="passo" onclick="VC.modos.setLente(\'passo\')">Passo</button><button class="lente-btn" data-lente="hasse" onclick="VC.modos.setLente(\'hasse\')">Hasse</button><button class="lente-btn" data-lente="tabela" onclick="VC.modos.setLente(\'tabela\')">Tabela de Dados</button><button class="lente-btn" data-lente="kanban" onclick="VC.modos.setLente(\'kanban\')">Kanban</button>'; }
    if (typeof VC.modos.setJanela === 'function') VC.modos.setJanela(janelaNum);
    if (lente && typeof VC.modos.setLente === 'function') VC.modos.setLente(lente);
    if (VC.debug && VC.debug.info) { VC.debug.info('[Layout V2] Fase 4.1 · janela ' + janelaNum + ' ativa · lente ' + (lente || 'passo')); }
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', function () { setTimeout(function () { inicializarLayoutV2(0); }, 500); }); } else { setTimeout(function () { inicializarLayoutV2(0); }, 500); }
})();

console.log('%c[VentCondutas V11.0.0] 08-arranque carregado · FIX: proteção defensiva para VC.passos', 'color:#6d8fb0;font-weight:bold;background:#eaf1f7;padding:3px 6px;border-radius:3px');

})();