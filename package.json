{
  "name": "venticondutas",
  "version": "11.1.0",
  "private": true,
  "description": "VentiCondutas — dimensionamento de redes de ventilação (app estática, index.html)",
  "scripts": {
    "verificar": "node tools/verificar.js",
    "verificar:rapido": "node tools/verificar.js --sem-percurso",
    "lint": "eslint",
    "fotografia": "node tools/fotografia.js --gravar fotografia.json",
    "comparar": "node tools/fotografia.js --comparar fotografia.json",
    "referencia": "node tools/fotografia.js --gravar tests/fotografia-referencia.json",
    "regressao": "node tools/fotografia.js --comparar tests/fotografia-referencia.json",
    "mutacoes": "node tools/mutacoes.js",
    "testes": "npm run verificar && npm run regressao && npm run mutacoes"
  },
  "devDependencies": {
    "@eslint/js": "9.15.0",
    "eslint": "9.15.0",
    "globals": "15.12.0",
    "playwright": "1.48.2"
  }
}
