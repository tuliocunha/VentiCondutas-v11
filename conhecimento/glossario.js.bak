   ============================================================ */
(function () {
'use strict';
window.VC = window.VC || {};
VC._glossario = {
  tooltips: {
    tipo_espaco: { tipo: 'tecnico', titulo: 'Tipo de Espaço', desc: 'Define a categoria do espaço para enquadramento normativo.', contexto: 'Determina se o espaço é de ocupação permanente, de passagem, ou de extração dedicada, influenciando a via de cálculo.', norma: 'Portaria 138-I/2021' },
    grupo_portaria: { tipo: 'tecnico', titulo: 'Grupo Normativo', desc: 'Classificação normativa do espaço (G1 a G4).', contexto: 'G1: Ocupação permanente (T11/T12). G2: Transferência. G3: Baixa emissão. G4: Extração dedicada (T13).', norma: 'Portaria 138-I/2021' },
    area_geometrica: { tipo: 'tecnico', titulo: 'Área útil (A)', simbolo: 'A', unidade: 'm²', desc: 'Área do pavimento do espaço.', contexto: 'Usada no cálculo da taxa de diluição basal de poluentes dos materiais de construção (T12).', formula: 'Q_min = A × T12', norma: 'Portaria 138-I/2021' },
    pe_direito: { tipo: 'tecnico', titulo: 'Pé-direito (H)', simbolo: 'H', unidade: 'm', desc: 'Altura média do teto.', contexto: 'Multiplicada pela área para obter o volume geométrico do espaço (caso não seja imposto manualmente).', formula: 'V = A × H' },
    volume_espaco: { tipo: 'tecnico', titulo: 'Volume do espaço (V)', simbolo: 'V', unidade: 'm³', desc: 'Volume interior de ar.', contexto: 'Multiplicador para o cálculo do caudal de conforto térmico (RPH) e divisor para verificação das renovações horárias globais (ACH).', formula: 'Q_ConTerm = V × RPH' },
    ocupacao: { tipo: 'tecnico', titulo: 'Ocupação de projeto (N)', simbolo: 'N', unidade: 'pessoas', desc: 'Número de ocupantes expectáveis.', contexto: 'Fator primário para o cálculo metabólico/respiratório na Tabela 11.', formula: 'Q_min = N × T11', norma: 'Portaria 138-I/2021' },
    RPH: { tipo: 'tecnico', titulo: 'Renovações por hora de conforto', simbolo: 'RPH', unidade: 'h⁻¹', contexto: 'Parâmetro de conforto térmico introduzido para compensar cargas sensíveis/latentes.', desc: 'Renovações de ar impostas pelo projetista.', formula: 'Q_ConTerm = V × RPH', norma: 'EN 16798-1 · ASHRAE 55', efeito: 'Aumenta diretamente a parcela Q_ConTerm do caudal total.' },
    Q_ConTerm: { tipo: 'tecnico', titulo: 'Caudal de Conforto Térmico', simbolo: 'Q_ConTerm', unidade: 'm³/h', desc: 'Parcela de caudal calculada para suprir exigências térmicas.', contexto: 'Deriva da imposição manual de uma taxa RPH (Renovações por Hora) pelo projetista.', formula: 'Q_ConTerm = V × RPH', norma: 'EN 16798-1' },
    QAI_projeto: { tipo: 'tecnico', titulo: 'Caudal QAI de Projeto', simbolo: 'QAI_projeto', unidade: 'm³/h', desc: 'Caudal adicional discricionário.', contexto: 'Não deriva de fórmula obrigatória. Imposto manualmente com base num motivo auditável (ex: hotte, pressurização).' },
    Q_total: { tipo: 'tecnico', titulo: 'Caudal Total de Projeto', simbolo: 'Q_total', unidade: 'm³/h', desc: 'Somatório de todas as parcelas de ar requeridas.', contexto: 'É o valor final e decisivo que servirá de alvo matemático para o dimensionamento dos terminais físicos neste espaço.', formula: 'Q_total = Q_normas + Q_ConTerm + QAI_projeto' },
    rho: { tipo: 'tecnico', titulo: 'Massa volúmica do ar', simbolo: 'ρ', unidade: 'kg/m³', contexto: 'A massa volúmica é o "peso" do ar por metro cúbico. Depende de três fatores: altitude, temperatura e humidade relativa.', desc: 'Massa de ar por unidade de volume. Calculada por ISA + ar húmido.', formula: 'ρ = (p − p_v)/(R_d·T) + p_v/(R_v·T)', norma: 'ASHRAE · ISO 2533', efeito: 'Aumentar ρ → maior Δp linear → maior potência do ventilador.', valoresTipicos: [{ material: 'Nível do mar, 15 °C', valor: '1.225 kg/m³' }, { material: '1000 m, 15 °C', valor: '1.112 kg/m³' }] },
    nu: { tipo: 'tecnico', titulo: 'Viscosidade cinemática', simbolo: 'ν', unidade: 'm²/s', contexto: 'A viscosidade cinemática mede a "resistência interna" do ar ao escoamento.', desc: 'Viscosidade dinâmica dividida pela massa volúmica.', formula: 'ν = μ / ρ', norma: 'ISO 2533', efeito: 'Aumentar ν → menor Re → escoamento mais laminar.' },
    T: { tipo: 'tecnico', titulo: 'Temperatura do ar', simbolo: 'T', unidade: '°C', contexto: 'A temperatura é a premissa mais fundamental do projeto. Afeta a massa volúmica (ρ), a viscosidade (ν) e a entalpia.', desc: 'Temperatura de referência para os cálculos ISA e ar húmido.', efeito: 'Aumentar T → menor ρ → menor Δp → menor potência.' },
    RH: { tipo: 'tecnico', titulo: 'Humidade relativa', simbolo: 'RH', unidade: '%', contexto: 'A humidade relativa é a razão entre a pressão parcial de vapor de água no ar e a pressão de saturação.', desc: 'Percentagem de saturação de vapor de água no ar.', norma: 'ASHRAE · EN 16798-1', efeito: 'Aumentar RH → ligeiramente menor ρ → ligeiramente menor Δp.' },
    eps: { tipo: 'tecnico', titulo: 'Rugosidade absoluta da conduta', simbolo: 'ε', unidade: 'mm', contexto: 'A rugosidade é a altura média das imperfeições na parede interior da conduta.', desc: 'Altura média das asperezas da parede interior.', formula: 'f = f(Re, ε/D)', norma: 'Colebrook-White · EN 12237', efeito: 'Aumentar ε → maior f → maior Δp linear.', valoresTipicos: [{ material: 'Aço galvanizado', valor: '0,15 mm' }, { material: 'PVC / plástico', valor: '0,0015 mm' }] },
    f: { tipo: 'tecnico', titulo: 'Fator de atrito de Darcy', simbolo: 'f', unidade: '—', contexto: 'O fator de atrito traduz a resistência ao escoamento provocada pela parede da conduta.', desc: 'Coeficiente de atrito de Darcy-Weisbach.', formula: '1/√f = −2·log₁₀(ε/(3,7·D) + 2,51/(Re·√f))', norma: 'Colebrook-White · Moody', efeito: 'Aumentar f → maior Δp linear.' },
    Re: { tipo: 'tecnico', titulo: 'Número de Reynolds', simbolo: 'Re', unidade: '—', contexto: 'O Reynolds compara as forças de inércia com as forças viscosas. Diz-nos se o escoamento é laminar, crítico ou turbulento.', desc: 'Razão entre forças de inércia e viscosas.', formula: 'Re = v · D / ν', norma: 'Reynolds · Colebrook-White', efeito: 'Re < 2300 → laminar. Re > 4000 → turbulento.' },
    Q: { tipo: 'tecnico', titulo: 'Caudal volumétrico', simbolo: 'Q', unidade: 'm³/h', contexto: 'O caudal é a quantidade de ar que passa por um ponto por unidade de tempo.', desc: 'Volume de ar por unidade de tempo.', formula: 'Q = v · A', norma: 'Portaria 138-I/2021', efeito: 'Aumentar Q → maior secção ou maior velocidade → maior Δp.' },
    Q_normas: { tipo: 'tecnico', titulo: 'Caudal obrigatório (norma)', simbolo: 'Q_normas', unidade: 'm³/h', contexto: 'É o caudal mínimo que cada espaço exige, calculado pela Portaria 138-I/2021.', desc: 'Caudal mínimo legal. P138 ou NP 1037.', formula: 'Q_normas = max(T11·N, T12·A) / ε_v', norma: 'Portaria 138-I/2021 · NP 1037', efeito: 'Alterar o tipo, área ou ocupação de um espaço tem impacto direto em todo o sistema.' },
    Qrenov: { tipo: 'tecnico', titulo: 'Caudal de renovação', simbolo: 'Q_renov', unidade: 'm³/h', contexto: 'É o caudal de ar novo necessário para renovar o ar do espaço.', desc: 'Caudal de ar novo calculado pela P138.', norma: 'Portaria 138-I/2021', efeito: 'Este caudal tem de entrar no espaço por insuflação direta ou por transferência.' },
    Qextracao: { tipo: 'tecnico', titulo: 'Caudal de extração', simbolo: 'Q_extracao', unidade: 'm³/h', contexto: 'É o caudal de ar viciado a extrair do espaço.', desc: 'Caudal de ar a extrair do espaço.', norma: 'Portaria 138-I T13', efeito: 'Aumentar a extração num espaço G4 obriga a aumentar a transferência de entrada.' },
    ACH: { tipo: 'tecnico', titulo: 'Renovações por hora', simbolo: 'ACH', unidade: 'h⁻¹', contexto: 'ACH = Air Changes per Hour. É o número de vezes que todo o volume do espaço é substituído por ar novo em uma hora.', desc: 'Volume de ar novo por hora dividido pelo volume do espaço.', formula: 'ACH = Q / V', norma: 'Portaria 138-I/2021', efeito: 'Aumentar ACH → mais caudal → mais renovação → mais energia.' },
    T11: { tipo: 'tecnico', titulo: 'Caudal por ocupante (T11)', simbolo: 'T11', unidade: 'm³/(h·pessoa)', contexto: 'A Tabela 11 da Portaria 138-I define o caudal mínimo de ar novo por ocupante.', desc: 'Caudal mínimo de ar novo por ocupante.', norma: 'Portaria 138-I/2021 · Tabela T11', efeito: 'Mais ocupantes → mais caudal exigido.' },
    T12: { tipo: 'tecnico', titulo: 'Caudal por área (T12)', simbolo: 'T12', unidade: 'm³/(h·m²)', contexto: 'A Tabela 12 da Portaria 138-I define o caudal mínimo de ar novo por m² de área útil.', desc: 'Caudal mínimo de ar novo por m² de área útil.', norma: 'Portaria 138-I/2021 · Tabela T12', efeito: 'Espaços maiores exigem mais caudal mesmo vazios.' },
    T13: { tipo: 'tecnico', titulo: 'Extração dedicada (T13)', simbolo: 'T13', unidade: 'm³/h', contexto: 'A Tabela 13 da Portaria 138-I define os caudais mínimos de extração para espaços G4.', desc: 'Caudal mínimo de extração para espaços G4.', norma: 'Portaria 138-I/2021 · Tabela T13', efeito: 'Aumentar extração num espaço G4 obriga a maior transferência de entrada.' },
    ACHmin: { tipo: 'tecnico', titulo: 'Renovações mínimas por hora', simbolo: 'ACH_min', unidade: 'h⁻¹', contexto: 'Valor mínimo de renovações por hora exigido para o tipo de espaço.', desc: 'Renovações mínimas obrigatórias por hora.', norma: 'Portaria 138-I/2021', efeito: 'Espaços de grande volume exigem caudal significativo só para cumprir este mínimo.' },
    ev: { tipo: 'tecnico', titulo: 'Eficácia de remoção', simbolo: 'ε_v', unidade: '—', contexto: 'A eficácia de remoção mede a capacidade do sistema em remover poluentes junto à sua fonte.', desc: 'Eficácia de remoção de poluentes.', norma: 'EN 16798-1 · ASHRAE 62.1', efeito: 'ε_v > 1 permite caudal menor. ε_v < 1 exige caudal maior.' },
    rph: { tipo: 'tecnico', titulo: 'Renovações por hora de conforto', simbolo: 'RPH', unidade: 'h⁻¹', contexto: 'O RPH é um parâmetro de conforto térmico, não de QAI.', desc: 'Renovações por hora para conforto térmico.', formula: 'Q_ConTerm = RPH × V', norma: 'EN 16798-1:2019 · ASHRAE 55:2020', efeito: 'Aumentar RPH → mais caudal de conforto → melhor mistura.', valoresTipicos: [{ material: 'Circulação H > 7 m', valor: '3 h⁻¹ (severa)' }] },
    rphDefault: { tipo: 'tecnico', titulo: 'RPH default (normativo)', simbolo: 'RPH_default', unidade: 'h⁻¹', contexto: 'O RPH default é o valor calculado automaticamente pela norma.', desc: 'Valor normativo de RPH.', norma: 'EN 16798-1:2019 · ASHRAE 55:2020', efeito: 'É o ponto de partida.' },
    rphAplicado: { tipo: 'tecnico', titulo: 'RPH aplicado', simbolo: 'RPH_aplicado', unidade: 'h⁻¹', contexto: 'O RPH aplicado é o valor efetivamente usado no cálculo do caudal de conforto.', desc: 'Valor efetivamente aplicado.', formula: 'Q_ConTerm = RPH_aplicado × V', norma: 'EN 16798-1:2019 · ASHRAE 55:2020', efeito: 'Alterar o RPH aplicado muda o caudal de conforto.' },
    rphOrigem: { tipo: 'contexto', titulo: 'Origem do valor de RPH', contexto: 'Indica se o RPH aplicado a um espaço veio da norma ou foi definido pelo engenheiro.', desc: 'Origem do RPH aplicado: Norma (📘) ou Utilizador (👤).', efeito: 'Distinguir os valores automáticos dos valores decididos pelo engenheiro.' },
    Q_ConTerm: { tipo: 'tecnico', titulo: 'Caudal de conforto térmico', simbolo: 'Q_ConTerm', unidade: 'm³/h', contexto: 'É o caudal adicional de ar que se insufla (ou se extrai, em G4) apenas para garantir conforto térmico.', desc: 'Caudal adicional para conforto térmico = RPH × V.', formula: 'Q_ConTerm = RPH_aplicado × V', norma: 'EN 16798-1 · ASHRAE 55', efeito: 'Aumentar Q_ConTerm → mais mistura de ar → menos estratificação.' },
    Q_total: { tipo: 'tecnico', titulo: 'Caudal total do espaço', simbolo: 'Q_total', unidade: 'm³/h', contexto: 'É o caudal final a considerar no espaço, somando Q_normas, Q_ConTerm e QAI_projeto.', desc: 'Q_normas + Q_ConTerm + QAI_projeto.', formula: 'Q_total = Q_normas + Q_ConTerm + QAI_projeto', norma: 'Portaria 138-I/2021 + EN 16798-1', efeito: 'É este o valor usado na materialização dos terminais.' },
    QAI_projeto: { tipo: 'tecnico', titulo: 'Caudal de QAI do projeto', simbolo: 'QAI_projeto', unidade: 'm³/h', contexto: 'É um caudal adicional definido pelo engenheiro, para além do Q_normas.', desc: 'Caudal de QAI definido pelo engenheiro.', norma: 'Boas práticas', efeito: 'Aumentar QAI_projeto → mais renovação de ar.', valoresTipicos: [{ material: 'Arrumo com produtos', valor: '20-40 m³/h' }] },
    QAI_rede: { tipo: 'contexto', titulo: 'Rede do QAI_projeto', contexto: 'Define onde é que o QAI_projeto entra no balanço.', desc: 'Onde o QAI_projeto entra: auto, insuflacao, extracao.', efeito: 'Override manual permite direcionar o caudal para a rede mais adequada.' },
    QAI_motivo: { tipo: 'contexto', titulo: 'Motivo do QAI_projeto', contexto: 'Texto livre que documenta por que razão o engenheiro definiu QAI_projeto.', desc: 'Justificação textual da decisão do engenheiro.', efeito: 'Sem motivo, não é permitido guardar o QAI_projeto.' },
    G1: { tipo: 'contexto', titulo: 'G1 — Ocupação Permanente', contexto: 'Espaços onde as pessoas permanecem longos períodos.', desc: 'Grupo 1: ocupação permanente.', norma: 'Portaria 138-I/2021' },
    G2: { tipo: 'contexto', titulo: 'G2 — Zona de Transferência', contexto: 'Espaços de passagem: circulações, escadas, arrumos.', desc: 'Grupo 2: zona de transferência.', norma: 'Portaria 138-I/2021' },
    G3: { tipo: 'contexto', titulo: 'G3 — Baixa Emissão', contexto: 'Espaços com baixa ocupação mas necessidade de diluição de poluentes.', desc: 'Grupo 3: baixa emissão.', norma: 'Portaria 138-I/2021' },
    G4: { tipo: 'contexto', titulo: 'G4 — Extração Dedicada', contexto: 'Espaços com poluentes específicos que exigem extração dedicada.', desc: 'Grupo 4: extração dedicada.', norma: 'Portaria 138-I/2021' },
    v: { tipo: 'tecnico', titulo: 'Velocidade do ar', simbolo: 'v', unidade: 'm/s', contexto: 'A velocidade do ar dentro da conduta afeta o ruído, a perda de carga e o conforto.', desc: 'Velocidade média do escoamento.', formula: 'v = Q / A', norma: 'VDI 2081 · CIBSE', efeito: 'Aumentar v → maior Δp (v²) → maior ruído.', valoresTipicos: [{ material: 'Tronco principal insuflação', valor: '4,0 – 6,0 m/s' }] },
    dP: { tipo: 'tecnico', titulo: 'Perda de carga', simbolo: 'Δp', unidade: 'Pa', contexto: 'A perda de carga é a energia que o ar perde ao longo do percurso.', desc: 'Diferença de pressão entre dois pontos do escoamento.', formula: 'Δp_lin = f·(L/D)·(ρ·v²/2) + Δp_sing = ζ·(ρ·v²/2)', norma: 'Darcy-Weisbach · Colebrook-White', efeito: 'Aumentar Δp → ventilador mais potente → mais energia.' },
    L: { tipo: 'tecnico', titulo: 'Comprimento do troço', simbolo: 'L', unidade: 'm', contexto: 'Comprimento reto da conduta entre dois nós.', desc: 'Comprimento reto do ramal.', efeito: 'Aumentar L → maior Δp linear.' },
    D: { tipo: 'tecnico', titulo: 'Diâmetro da conduta', simbolo: 'D', unidade: 'mm', contexto: 'O diâmetro é o parâmetro que o engenheiro escolhe para garantir que a velocidade e a perda unitária respeitam os limites.', desc: 'Diâmetro nominal da conduta.', norma: 'EN 1506 · EN 1505', efeito: 'Aumentar D → menor v → menor Δp → mais espaço ocupado.' },
    A: { tipo: 'tecnico', titulo: 'Área da secção', simbolo: 'A', unidade: 'm²', contexto: 'Área útil da secção transversal.', desc: 'Área da secção transversal.', formula: 'A = π·D²/4 (circular) · A = b·h (retangular)', efeito: 'Aumentar A → menor v para o mesmo Q.' },
    V: { tipo: 'tecnico', titulo: 'Volume do espaço', simbolo: 'V', unidade: 'm³', contexto: 'Volume interior do espaço (área × altura).', desc: 'Volume útil do espaço.', formula: 'V = A · H', efeito: 'Espaços com pé-direito duplo têm volume grande.' },
    H: { tipo: 'tecnico', titulo: 'Altura do espaço', simbolo: 'H', unidade: 'm', contexto: 'Altura entre o pavimento e o teto.', desc: 'Altura útil do espaço.', efeito: 'Aumentar H → mais volume → maior RPH default.' },
    zeta: { tipo: 'tecnico', titulo: 'Coeficiente de perda singular', simbolo: 'ζ', unidade: '—', contexto: 'O coeficiente ζ quantifica a perda de carga introduzida por uma singularidade.', desc: 'Coeficiente de perda localizada.', formula: 'Δp_sing = ζ · (ρ·v²/2)', norma: 'ASHRAE · CIBSE', efeito: 'Aumentar ζ → maior perda singular.' },
    P: { tipo: 'tecnico', titulo: 'Potência do ventilador', simbolo: 'P', unidade: 'W', contexto: 'Potência ao eixo do ventilador.', desc: 'Potência ao eixo do ventilador.', formula: 'P = Q · Δp / η', norma: 'EN 16798-3 · DL 101-D/2020', efeito: 'Aumentar Q ou Δp → mais potência.' },
    sfp: { tipo: 'tecnico', titulo: 'SFPint — Specific Fan Power', simbolo: 'SFPint', unidade: 'W/(m³/s)', contexto: 'O SFPint é o indicador europeu de eficiência energética de ventiladores.', desc: 'Razão entre a potência elétrica do ventilador e o caudal de ar.', formula: 'SFPint = Δp_int / η_vent', norma: 'EN 16798-3 · Regulamento UE 1253/2014', efeito: 'Reduzir SFPint → filtros com menor Δp.' },
    eta: { tipo: 'tecnico', titulo: 'Eficiência do ventilador', simbolo: 'η', unidade: '—', contexto: 'Eficiência global do ventilador.', desc: 'Eficiência global do ventilador.', norma: 'Regulamento UE 1253/2014', efeito: 'Aumentar η → menos potência.' },
    etaRec: { tipo: 'tecnico', titulo: 'Rendimento do recuperador', simbolo: 'η_rec', unidade: '—', contexto: 'Eficiência de recuperação de calor do permutador ar-ar.', desc: 'Rendimento do recuperador de calor.', norma: 'Regulamento UE 1253/2014', efeito: 'Aumentar η_rec → menos energia gasta.' },
    Qin: { tipo: 'tecnico', titulo: 'Caudal de insuflação direta', simbolo: 'Q_in', unidade: 'm³/h', contexto: 'Total de caudal que ENTRA no espaço por insuflação direta.', desc: 'Caudal que entra no espaço.', norma: 'Balanço de massa', efeito: 'Aumentar Q_in → espaço em sobrepressão.' },
    Qout: { tipo: 'tecnico', titulo: 'Caudal de extração direta', simbolo: 'Q_out', unidade: 'm³/h', contexto: 'Total de caudal que SAI do espaço por extração direta.', desc: 'Caudal que sai do espaço.', norma: 'Balanço de massa', efeito: 'Aumentar Q_out → espaço em depressão.' },
    Qtrf: { tipo: 'tecnico', titulo: 'Caudal de transferência', simbolo: 'Q_trf', unidade: 'm³/h', contexto: 'Caudal que atravessa uma transferência entre dois espaços.', desc: 'Caudal de ar que atravessa uma abertura.', formula: 'A = Q / (0,36·√ΔP)  (A cm², Q m³/h, ΔP Pa)', norma: 'Portaria 138-I T13', efeito: 'Aumentar Q_trf → maior área do vão.' },
    residuo: { tipo: 'tecnico', titulo: 'Resíduo de balanço', simbolo: 'ΔQ', unidade: 'm³/h', contexto: 'Diferença entre caudais que entram e caudais que saem do espaço.', desc: 'Diferença entre entradas e saídas.', formula: 'ΔQ = (Q_in + Q_trf_in) − (Q_out + Q_trf_out)', norma: 'Balanço de massa · P1', efeito: 'ΔQ dentro de ±5 m³/h → OK.' },
    fresta_porta: { tipo: 'tecnico', titulo: 'Fresta sob porta', simbolo: 'fresta_porta', unidade: 'cm²', contexto: 'Abertura natural sob a porta.', desc: 'Fresta sob porta.', formula: 'A = Q / (0,36·√ΔP)  (A cm², Q m³/h, ΔP Pa)', norma: 'Portaria 138-I T13' },
    grelha_transferencia: { tipo: 'tecnico', titulo: 'Grelha de transferência', simbolo: 'grelha_transf', unidade: 'cm²', contexto: 'Grelha instalada numa parede interior.', desc: 'Grelha de transferência.', formula: 'A = Q / (0,36·√ΔP)  (A cm², Q m³/h, ΔP Pa)', norma: 'Portaria 138-I T13' },
    grelha_parede: { tipo: 'tecnico', titulo: 'Grelha de parede', simbolo: 'grelha_parede', unidade: 'cm²', contexto: 'Grelha instalada numa parede.', desc: 'Grelha de parede.', formula: 'A = Q / (0,36·√ΔP)  (A cm², Q m³/h, ΔP Pa)', norma: 'Portaria 138-I T13' },
    abertura_natural: { tipo: 'tecnico', titulo: 'Abertura natural', simbolo: 'abertura_nat', unidade: 'cm²', contexto: 'Vão existente entre dois espaços.', desc: 'Abertura natural.', formula: 'A = Q / (0,36·√ΔP)  (A cm², Q m³/h, ΔP Pa)', norma: 'Portaria 138-I T13' },
    meta: { tipo: 'tecnico', titulo: 'Facetas do ramal', simbolo: 'meta', unidade: '—', contexto: 'Objeto que agrega facetas derivadas do ramal.', desc: 'Facetas derivadas do ramal.', norma: 'V9 · Topologia facetada', efeito: 'Permite agrupar por múltiplos critérios.' },
    pisoFisico: { tipo: 'tecnico', titulo: 'Piso físico (faceta)', simbolo: 'pisoFisico', unidade: '—', contexto: 'Array de pisos físicos onde o ramal está.', desc: 'Piso(s) físico(s).', norma: 'V9 · Topologia facetada', efeito: 'Permite agrupar.' },
